fn guid(uid: u64, role: u64, id: u64) -> String {
    let hi = mix(uid ^ mix(role.wrapping_mul(0x9E37_79B9_7F4A_7C15) ^ id));
    let lo = mix(hi ^ id.rotate_left(17) ^ role);
    compress((u128::from(hi) << 64) | u128::from(lo))
}

