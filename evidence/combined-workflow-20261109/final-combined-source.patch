+    fn boundary_rotation_mirroring_visibility_and_deletion_use_the_existing_commands() {
+        let mut s = Session::new();
+        let id = run(&mut s, "property_line", json!({"points":[[0,0],[6000,0],[6000,4000],[0,4000]]}))["id"].as_u64().unwrap();
+        let guid = s.model.guid(id);
+        run(&mut s, "rotate", json!({"id":guid,"about":[0,0],"angle":90}));
+        let rotated = run(&mut s, "elements", json!({"category":"propertyline"}));
+        assert_eq!(rotated["elements"][0]["segments"][0]["azimuth"], 0.0);
+        run(&mut s, "mirror", json!({"id":guid,"axis":[[0,0],[1000,0]]}));
+        let mirrored = run(&mut s, "elements", json!({"category":"propertyline"}));
+        assert_eq!(mirrored["elements"][0]["segments"][0]["azimuth"], 180.0);
+        assert_eq!(mirrored["elements"][0]["area_m2"], 24.0);
+        assert_eq!(s.model.guid(id), guid);
+        let level = s.model.level_of(s.model.elements.get(id).unwrap()).unwrap();
+        run(&mut s, "graphics", json!({"view":level,"hide":["propertyline"]}));
+        assert!(!render::plan(&s.model, level, 400, 300).owners.contains(&Some(id)));
+        run(&mut s, "graphics", json!({"view":level,"show":["propertyline"]}));
+        assert!(render::plan(&s.model, level, 400, 300).owners.contains(&Some(id)));
+        run(&mut s, "delete", json!({"ids":[guid]}));
+        assert!(!s.model.elements.contains_key(guid));
+        run(&mut s, "undo", json!({}));
+        assert_eq!(s.model.guid(id), guid);
+        s.model.check().unwrap();
+    }
+}
diff --git a/crates/core/tests/raised_wall_openings.rs b/crates/core/tests/raised_wall_openings.rs
new file mode 100644
index 00000000..66dcb0a2
--- /dev/null
+++ b/crates/core/tests/raised_wall_openings.rs
@@ -0,0 +1,108 @@
+//! Opening placement through the same public commands as the CLI and MCP.
+#[cfg(test)]
+mod tests {
+    use bimcraft_core::engine::Session;
+    use serde_json::{Value, json};
+
+    fn run(session: &mut Session, command: &str, params: Value) -> Value {
+        session.execute(command, &params).unwrap_or_else(|error| panic!("{command} {params}: {error}"))
+    }
+
+    #[test]
+    fn raised_wall_openings_render_and_keep_their_hosts_after_save_and_open() {
+        for command in ["door", "window"] {
+            let mut session = Session::new();
+            let wall = run(
+                &mut session,
+                "wall",
+                json!({"points": [[0,0],[8000,0]], "level": "Level 1", "base_offset": 6000, "height": 3000}),
+            )["ids"][0]
+                .clone();
+            let before = run(&mut session, "render", json!({"view": "{3D}", "width": 400, "height": 300}))["pngBase64"].clone();
+            let params = json!({"at": [4000,0], "level": "Level 1"});
+            let preview = bimcraft_core::opening_of(&session.model, &params, command == "door").unwrap();
+            let opening = run(&mut session, command, params);
+            assert_eq!(session.model.elements[&opening["id"].as_u64().unwrap()], preview, "desktop preview and placement agree");
+            assert_eq!(opening["host"], wall);
+            assert_eq!(opening["offset"], 4000.0);
+            let after = run(&mut session, "render", json!({"view": "{3D}", "width": 400, "height": 300}))["pngBase64"].clone();
+            assert!(after.is_string());
+            assert_ne!(before, after, "the placed opening must change the rendered wall");
+
+            let dir = tempfile::tempdir().unwrap();
+            let path = dir.path().join("raised-wall.bimcraft");
+            let elements = run(&mut session, "elements", json!({}));
+            run(&mut session, "save", json!({"path": path}));
+            let mut reopened = Session::new();
+            let opened = run(&mut reopened, "open", json!({"path": path}));
+            assert!(opened.get("left_out").is_none_or(|value| value.as_array().is_some_and(Vec::is_empty)), "{opened}");
+            assert_eq!(run(&mut reopened, "elements", json!({})), elements, "opening and GUID host must persist");
+            assert_eq!(run(&mut reopened, "render", json!({"view": "{3D}", "width": 400, "height": 300}))["pngBase64"], after);
+        }
+    }
+
+    #[test]
+    fn raised_host_lookup_preserves_cut_wall_priority_and_explicit_wall_control() {
+        for command in ["door", "window"] {
+            let mut session = Session::new();
+            let raised =
+                run(&mut session, "wall", json!({"points": [[0,0],[8000,0]], "base_offset": 6000, "height": 3000}))["ids"][0].clone();
+            let cut = run(&mut session, "wall", json!({"points": [[0,0],[8000,0]], "height": 3000}))["ids"][0].clone();
+            assert_eq!(run(&mut session, command, json!({"at": [2000,0], "level": "Level 1"}))["host"], cut);
+            assert_eq!(run(&mut session, command, json!({"wall": raised, "offset": 4000}))["host"], raised);
+        }
+    }
+
+    #[test]
+    fn stacked_raised_hosts_require_a_wall_id_and_refusal_changes_nothing() {
+        for command in ["door", "window"] {
+            let mut session = Session::new();
+            let first =
+                run(&mut session, "wall", json!({"points": [[0,0],[8000,0]], "base_offset": 6000, "height": 3000}))["ids"][0].clone();
+            let second =
+                run(&mut session, "wall", json!({"points": [[0,0],[8000,0]], "base_offset": 10000, "height": 3000}))["ids"][0].clone();
+            let before = run(&mut session, "elements", json!({}));
+            let error = session.execute(command, &json!({"at": [4000,0], "level": "Level 1"})).unwrap_err();
+            assert!(error.contains("ambiguous") && error.contains("wall"), "{error}");
+            assert_eq!(run(&mut session, "elements", json!({})), before);
+            for wall in [first, second] {
+                assert_eq!(run(&mut session, command, json!({"wall": wall, "offset": 4000}))["host"], wall);
+            }
+        }
+    }
+
+    #[test]
+    fn raised_wall_lookup_keeps_low_wall_and_other_level_diagnostics() {
+        for params in [
+            json!({"points": [[0,0],[8000,0]], "level": "Level 1", "height": 250}),
+            json!({"points": [[0,0],[8000,0]], "level": "Level 2", "base_offset": 6000, "height": 3000}),
+        ] {
+            let mut session = Session::new();
+            run(&mut session, "wall", params);
+            for command in ["door", "window"] {
+                let error = session.execute(command, &json!({"at": [4000,0], "level": "Level 1"})).unwrap_err();
+                assert!(error.contains("stands there") && error.contains("cuts at 1200"), "{error}");
+            }
+        }
+    }
+
+    #[test]
+    fn raised_wall_fallback_still_validates_sill_width_and_overlapping_openings() {
+        let mut session = Session::new();
+        run(&mut session, "wall", json!({"points": [[0,0],[8000,0]], "base_offset": 6000, "height": 3000}));
+        for (params, diagnostic) in [
+            (json!({"at": [4000,0], "level": "Level 1", "sill": -1}), "sill"),
+            (json!({"at": [4000,0], "level": "Level 1", "sill": 3000}), "top"),
+            (json!({"at": [0,0], "level": "Level 1"}), "doesn't fit"),
+        ] {
+            let before = run(&mut session, "elements", json!({}));
+            let error = session.execute("window", &params).unwrap_err();
+            assert!(error.contains(diagnostic), "{error}");
+            assert_eq!(run(&mut session, "elements", json!({})), before);
+        }
+        run(&mut session, "window", json!({"at": [4000,0], "level": "Level 1"}));
+        let before = run(&mut session, "elements", json!({}));
+        assert!(session.execute("window", &json!({"at": [4000,0], "level": "Level 1"})).is_err());
+        assert_eq!(run(&mut session, "elements", json!({})), before);
+    }
+}
diff --git a/crates/core/tests/roof_overhang.rs b/crates/core/tests/roof_overhang.rs
new file mode 100644
index 00000000..086eafe7
--- /dev/null
+++ b/crates/core/tests/roof_overhang.rs
@@ -0,0 +1,134 @@
+//! Roof commands exercised through the same public session used by CLI and MCP.
+#[cfg(test)]
+mod tests {
+    use bimcraft_core::engine::Session;
+    use serde_json::{Value, json};
+
+    fn run(s: &mut Session, cmd: &str, params: Value) -> Value {
+        s.execute(cmd, &params).unwrap_or_else(|e| panic!("{cmd} {params}: {e}"))
+    }
+
+    fn roof(s: &mut Session, id: &Value) -> Value {
+        run(s, "elements", json!({"category":"roof"}))["elements"].as_array().unwrap().iter().find(|r| &r["id"] == id).unwrap().clone()
+    }
+
+    #[test]
+    fn explicit_roof_overhang_extends_eaves_and_keeps_wall_line_height_after_reopen() {
+        for boundary in [json!([[0, 0], [10000, 0], [10000, 20000], [0, 20000]]), json!([[0, 20000], [10000, 20000], [10000, 0], [0, 0]])] {
+            let mut s = Session::new();
+            let id = run(
+                &mut s,
+                "roof",
+                json!({"level":"Level 1", "boundary":boundary, "overhang":750,"slope":10,"gables":[0,1,2],"offset":6000}),
+            )["id"]
+                .clone();
+            let expected = roof(&mut s, &id);
+            let mut outline: Vec<[f64; 2]> = serde_json::from_value(expected["outline"].clone()).unwrap();
+            outline.sort_by(|a, b| a.partial_cmp(b).unwrap());
+            assert_eq!(outline, vec![[-750., -750.], [-750., 20750.], [10750., -750.], [10750., 20750.]]);
+            assert!((expected["ridge"].as_f64().unwrap() - (6000. + 10750. * 10f64.to_radians().tan())).abs() < 0.02);
+            let dir = tempfile::tempdir().unwrap();
+            let path = dir.path().join("roof.bimcraft");
+            run(&mut s, "save", json!({"path":path}));
+            let mut reopened = Session::new();
+            run(&mut reopened, "open", json!({"path":path}));
+            assert_eq!(roof(&mut reopened, &id), expected);
+            run(&mut reopened, "render", json!({"view":"{3D}","path":dir.path().join("roof.png"),"width":400,"height":300}));
+            assert!(std::fs::metadata(dir.path().join("roof.png")).unwrap().len() > 1000);
+        }
+    }
+
+    #[test]
+    fn sketch_overhang_preserves_per_edge_pitches_and_edit_boundary_does_not_offset_twice() {
+        let mut s = Session::new();
+        let id = run(
+            &mut s,
+            "roof",
+            json!({"overhang":400,"slope":30,"sketch":[
+                {"start":[0,0],"end":[8000,0]}, {"start":[8000,0],"end":[8000,6000],"slope":45},
+                {"start":[8000,6000],"end":[0,6000]}, {"start":[0,6000],"end":[0,0],"slope":45}
+            ]}),
+        )["id"]
+            .clone();
+        let before = roof(&mut s, &id);
+        assert_eq!(before["outline"], json!([[-400., -400.], [8400., -400.], [8400., 6400.], [-400., 6400.]]));
+        assert_eq!(before["slopes"], json!([0., 45., 0., 45.]));
+        // Alignment picks the visible eave, rather than the input wall line, before the user edits it.
+        let picked = bimcraft_core::align::lines(&s.model, id.as_u64().unwrap());
+        assert!(picked.iter().any(|(a, b)| a.1 == -400. && b.1 == -400.), "visible south eave missing from alignment picks: {picked:?}");
+        let sketch = run(&mut s, "edit_boundary", json!({"id":id}))["sketch"].clone();
+        run(&mut s, "edit_boundary", json!({"id":id,"sketch":sketch}));
+        assert_eq!(roof(&mut s, &id)["outline"], before["outline"]);
+        assert_eq!(roof(&mut s, &id)["slopes"], before["slopes"]);
+    }
+
+    #[test]
+    fn courtyards_offset_inward_and_impossible_creation_is_atomic() {
+        let mut s = Session::new();
+        let before = s.model.to_json().unwrap();
+        let err = s.execute("roof", &json!({"boundary":[[0,0],[600,0],[600,600],[0,600]],"slope":0,"overhang":-400})).unwrap_err();
+        assert!(err.contains("overhang"), "{err}");
+        assert_eq!(s.model.to_json().unwrap(), before);
+        let err = s.execute("roof", &json!({"boundary":[[0,0],[10000,0],[10000,10000],[0,10000]],"courtyards":[[[4000,4000],[4000,4600],[4600,4600],[4600,4000]]],"slope":0,"overhang":400})).unwrap_err();
+        assert!(err.contains("courtyard"), "{err}");
+        let id = run(&mut s,"roof",json!({"boundary":[[0,0],[10000,0],[10000,10000],[0,10000]],"courtyards":[[[3000,3000],[3000,7000],[7000,7000],[7000,3000]]],"slope":0,"overhang":500}))["id"].clone();
+        assert_eq!(roof(&mut s, &id)["courtyards"], json!([[[3500., 3500.], [3500., 6500.], [6500., 6500.], [6500., 3500.]]]));
+    }
+
+    #[test]
+    fn impossible_mass_roof_update_refuses_all_elements_and_preserves_undo_redo() {
+        let mut s = Session::new();
+        let mass = run(&mut s, "mass", json!({"boundary":[[0,0],[8000,0],[8000,6000],[0,6000]],"height":3000}))["id"].clone();
+        let floor = run(&mut s, "floor_by_face", json!({"mass":mass}))["id"].clone();
+        let id = run(&mut s, "roof_by_face", json!({"mass":mass,"overhang":-400}))["id"].clone();
+        let initial = s.model.to_json().unwrap();
+        run(&mut s, "modify", json!({"id":mass,"boundary":[[0,0],[600,0],[600,600],[0,600]]}));
+        let before = s.model.to_json().unwrap();
+        let history: Vec<String> = s.history().iter().map(|s| s.to_string()).collect();
+        let err = s.execute("update_by_face", &json!({"ids":[floor,id]})).unwrap_err();
+        assert!(err.contains("overhang") && err.contains(&id.to_string()), "{err}");
+        assert_eq!(s.model.to_json().unwrap(), before, "a failed update must leave every element unchanged");
+        assert_eq!(s.history(), history);
+        run(&mut s, "undo", json!({}));
+        assert_eq!(s.model.to_json().unwrap(), initial, "failure must not consume an undo step");
+        run(&mut s, "redo", json!({}));
+        assert_eq!(s.model.to_json().unwrap(), before);
+        run(&mut s, "modify", json!({"id":mass,"boundary":[[0,0],[10000,0],[10000,6000],[0,6000]]}));
+        run(&mut s, "update_by_face", json!({"mass":mass}));
+        assert_eq!(roof(&mut s, &id)["outline"], json!([[400., 400.], [9600., 400.], [9600., 5600.], [400., 5600.]]));
+    }
+
+    #[test]
+    fn mass_roof_keeps_positive_overhang_identity_and_pitch_through_update_and_reopen() {
+        let mut s = Session::new();
+        let mass = run(&mut s, "mass", json!({"boundary":[[0,0],[8000,0],[8000,6000],[0,6000]],"height":3000}))["id"].clone();
+        let id = run(&mut s, "roof_by_face", json!({"mass":mass,"overhang":400,"slope":20}))["id"].clone();
+        let before = roof(&mut s, &id);
+        assert_eq!(before["outline"], json!([[-400., -400.], [8400., -400.], [8400., 6400.], [-400., 6400.]]));
+        run(&mut s, "modify", json!({"id":mass,"boundary":[[0,0],[10000,0],[10000,6000],[0,6000]]}));
+        run(&mut s, "update_by_face", json!({"mass":mass}));
+        let after = roof(&mut s, &id);
+        assert_eq!(after["outline"], json!([[-400., -400.], [10400., -400.], [10400., 6400.], [-400., 6400.]]));
+        for key in ["id", "guid", "type", "slope", "overhang"] {
+            assert_eq!(after[key], before[key], "updating the face must keep {key}");
+        }
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("mass-roof.bimcraft");
+        run(&mut s, "save", json!({"path":path}));
+        let mut reopened = Session::new();
+        run(&mut reopened, "open", json!({"path":path}));
+        assert_eq!(roof(&mut reopened, &id), after);
+        assert_eq!(run(&mut reopened, "update_by_face", json!({"mass":mass}))["unchanged"], json!([id]));
+    }
+
+    #[test]
+    fn wall_derived_roofs_and_zero_overhang_keep_existing_outlines() {
+        let mut s = Session::new();
+        run(&mut s, "wall", json!({"points":[[0,0],[8000,0],[8000,6000],[0,6000]],"closed":true}));
+        let id = run(&mut s, "roof", json!({}))["id"].clone();
+        let r = roof(&mut s, &id);
+        assert!(r["outline"][0][0].as_f64().unwrap() < -500.);
+        let id = run(&mut s, "roof", json!({"boundary":[[0,0],[8000,0],[8000,6000],[0,6000]],"slope":0}))["id"].clone();
+        assert_eq!(roof(&mut s, &id)["outline"], json!([[0., 0.], [8000., 0.], [8000., 6000.], [0., 6000.]]));
+    }
+}
diff --git a/crates/core/tests/scan_framing.rs b/crates/core/tests/scan_framing.rs
new file mode 100644
index 00000000..fcf4e123
--- /dev/null
+++ b/crates/core/tests/scan_framing.rs
@@ -0,0 +1,147 @@
+//! Automatic framing through the commands used by CLI and MCP clients.
+#[cfg(test)]
+mod tests {
+    use bimcraft_core::engine::Session;
+    use serde_json::{Value, json};
+    use std::path::Path;
+
+    fn run(session: &mut Session, command: &str, params: Value) -> Value {
+        session.execute(command, &params).unwrap_or_else(|e| panic!("{command}: {e}"))
+    }
+
+    fn building(session: &mut Session) {
+        run(session, "wall", json!({"points": [[0,0],[8000,0],[8000,6000],[0,6000]], "closed": true}));
+        run(session, "section", json!({"name": "Building section", "start": [-1000,3000], "end": [9000,3000]}));
+    }
+
+    fn scan(session: &mut Session, directory: &Path) -> u64 {
+        let path = directory.join("synthetic.xyz");
+        std::fs::write(&path, "0 0 0 255 0 0\n4 0 0 255 0 0\n0 3 2 255 0 0\n4 3 2 255 0 0\n").unwrap();
+        run(session, "point_cloud", json!({"path": path, "at": [200000,200000]}))["id"].as_u64().unwrap()
+    }
+
+    fn picture(session: &mut Session, directory: &Path, view: &str, name: &str) -> Vec<u8> {
+        let path = directory.join(format!("{name}.png"));
+        run(session, "render", json!({"view": view, "path": path, "width": 640, "height": 480}));
+        let png = std::fs::read(&path).unwrap();
+        if let Some(dump) = std::env::var_os("BIMCRAFT_FRAMING_DUMP") {
+            std::fs::create_dir_all(&dump).unwrap();
+            std::fs::copy(&path, Path::new(&dump).join(format!("{name}.png"))).unwrap();
+        }
+        png
+    }
+
+    fn red_pixels(png: &[u8]) -> usize {
+        tiny_skia::Pixmap::decode_png(png).unwrap().pixels().iter().filter(|p| p.red() > 200 && p.green() < 60 && p.blue() < 60).count()
+    }
+
+    #[test]
+    fn adding_a_distant_scan_keeps_the_building_readable_in_default_views_after_reopening() {
+        let directory = tempfile::tempdir().unwrap();
+        let mut session = Session::new();
+        building(&mut session);
+        let section = picture(&mut session, directory.path(), "Building section", "section-before");
+        let parallel = picture(&mut session, directory.path(), "{3D}", "parallel-before");
+        run(&mut session, "perspective", json!({"on": true}));
+        let perspective = picture(&mut session, directory.path(), "{3D}", "perspective-before");
+        scan(&mut session, directory.path());
+        let perspective_after = picture(&mut session, directory.path(), "{3D}", "perspective-after");
+        run(&mut session, "perspective", json!({"on": false}));
+        let parallel_after = picture(&mut session, directory.path(), "{3D}", "parallel-after");
+        let section_after = picture(&mut session, directory.path(), "Building section", "section-after");
+        let project = directory.path().join("building.bimcraft");
+        run(&mut session, "save", json!({"path": project}));
+        let mut reopened = Session::new();
+        run(&mut reopened, "open", json!({"path": project}));
+        assert_eq!(run(&mut reopened, "elements", json!({"category": "pointcloud"}))["count"], 1);
+        let parallel_reopened = picture(&mut reopened, directory.path(), "{3D}", "parallel-reopened");
+        let section_reopened = picture(&mut reopened, directory.path(), "Building section", "section-reopened");
+        run(&mut reopened, "perspective", json!({"on": true}));
+        let perspective_reopened = picture(&mut reopened, directory.path(), "{3D}", "perspective-reopened");
+        let same = [
+            ("section", section == section_after && section == section_reopened),
+            ("parallel", parallel == parallel_after && parallel == parallel_reopened),
+            ("perspective", perspective == perspective_after && perspective == perspective_reopened),
+        ];
+        println!("building framing unchanged after scan import and save/open: {same:?}");
+        assert!(same.iter().all(|(_, same)| *same), "a distant scan changed automatic building framing: {same:?}");
+    }
+
+    #[test]
+    fn scan_only_fitting_still_shows_scans_in_parallel_and_perspective() {
+        let directory = tempfile::tempdir().unwrap();
+        for hidden_building in [false, true] {
+            let mut session = Session::new();
+            if hidden_building {
+                building(&mut session);
+            }
+            scan(&mut session, directory.path());
+            if !hidden_building {
+                use bimcraft_core::geom::P2;
+                assert_eq!(session.model.model_extent(), [P2(197000.0, 197500.0), P2(203000.0, 202500.0)]);
+            }
+            run(&mut session, "graphics", json!({"view": "{3D}", "hide": ["wall", "level"]}));
+            for perspective in [false, true] {
+                run(&mut session, "perspective", json!({"on": perspective}));
+                let png = picture(&mut session, directory.path(), "{3D}", &format!("scan-only-{hidden_building}-{perspective}"));
+                assert!(
+                    red_pixels(&png) >= 8,
+                    "the fitted scan must remain visible with hidden_building={hidden_building}, perspective={perspective}"
+                );
+            }
+        }
+    }
+
+    #[test]
+    fn explicit_camera_and_crops_keep_scans_visible_and_survive_save_open() {
+        let directory = tempfile::tempdir().unwrap();
+        let mut session = Session::new();
+        building(&mut session);
+        scan(&mut session, directory.path());
+        run(&mut session, "camera", json!({"name": "Scan camera", "eye": [190000,190000,6000], "target": [200000,200000,1000]}));
+        run(&mut session, "crop", json!({"view": "Level 1", "region": [[197000,198000],[203000,202000]]}));
+        run(&mut session, "section", json!({"name": "Scan section", "start": [197000,198000], "end": [203000,198000]}));
+        run(&mut session, "crop", json!({"view": "Scan section", "region": [[0,-100],[6000,3000]]}));
+        let views = ["Scan camera", "Level 1", "Scan section"];
+        let before: Vec<_> =
+            views.iter().enumerate().map(|(i, v)| picture(&mut session, directory.path(), v, &format!("explicit-{i}"))).collect();
+        assert!(before.iter().all(|png| red_pixels(png) >= 8), "explicit views must still draw the distant scan");
+        let project = directory.path().join("explicit.bimcraft");
+        run(&mut session, "save", json!({"path": project}));
+        let mut reopened = Session::new();
+        run(&mut reopened, "open", json!({"path": project}));
+        for (i, view) in views.iter().enumerate() {
+            assert_eq!(before[i], picture(&mut reopened, directory.path(), view, &format!("explicit-reopened-{i}")));
+        }
+        let camera = run(&mut reopened, "camera", json!({"view": "Scan camera"}));
+        assert_eq!(camera["eye"], json!([190000.0, 190000.0, 6000.0]));
+        assert_eq!(camera["target"], json!([200000.0, 200000.0, 1000.0]));
+        let error = reopened.execute("point_cloud", &json!({"path": directory.path().join("missing.xyz")})).unwrap_err();
+        assert!(error.contains("missing.xyz"), "{error}");
+        assert_eq!(before[0], picture(&mut reopened, directory.path(), "Scan camera", "explicit-after-failed-import"));
+        assert_eq!(run(&mut reopened, "elements", json!({"category": "pointcloud"}))["count"], 1);
+    }
+
+    #[test]
+    fn empty_fitting_and_explicit_level_extents_are_preserved() {
+        use bimcraft_core::geom::P2;
+        let directory = tempfile::tempdir().unwrap();
+        let mut session = Session::new();
+        assert_eq!(session.model.model_extent(), [P2(-10000.0, -10000.0), P2(10000.0, 10000.0)]);
+        for perspective in [false, true] {
+            run(&mut session, "perspective", json!({"on": perspective}));
+            let png = picture(&mut session, directory.path(), "{3D}", &format!("empty-{perspective}"));
+            assert_eq!(red_pixels(&png), 0);
+        }
+        let id =
+            run(&mut session, "level", json!({"name": "Explicit", "elevation": 6000, "extent": [[-50000,-40000],[30000,20000]]}))["id"]
+                .as_u64()
+                .unwrap();
+        building(&mut session);
+        scan(&mut session, directory.path());
+        assert_eq!(session.model.level_extent(id), Some([P2(-50000.0, -40000.0), P2(30000.0, 20000.0)]));
+        // An automatically fitted section box still encloses scans: it is an explicit clipping tool, not a framing default.
+        let section_box = run(&mut session, "section_box", json!({}));
+        assert!(section_box["max"][0].as_f64().unwrap() > 200000.0, "{section_box}");
+    }
+}
diff --git a/crates/core/tests/script_references.rs b/crates/core/tests/script_references.rs
new file mode 100644
index 00000000..e879c357
--- /dev/null
+++ b/crates/core/tests/script_references.rs
@@ -0,0 +1,297 @@
+//! Scripts create, reference, persist and reopen synthetic elements through the public session.
+#[cfg(test)]
+mod tests {
+    use bimcraft_core::engine::Session;
+    use serde_json::json;
+
+    #[test]
+    fn named_script_results_create_a_hosted_door_and_survive_save_reopen() {
+        let mut s = Session::new();
+        let out = s
+            .script(
+                r#"@walls = wall {"points": [[0,0],[8000,0],[8000,6000]]}
+door {"wall": "@walls.ids.1", "offset": 3000}
+modify {"id": "$last", "mark": "Entry"}"#,
+            )
+            .unwrap();
+        let door = out[1]["id"].as_u64().unwrap();
+        let wall = out[0]["ids"][1].as_u64().unwrap();
+        let before = s.execute("elements", &json!({"category":"doors"})).unwrap();
+        let host: bimcraft_core::model::Guid = serde_json::from_value(before["elements"][0]["host"].clone()).unwrap();
+        assert!(s.model.same(host, wall));
+        assert_eq!(before["elements"][0]["id"], door);
+        assert_eq!(before["elements"][0]["mark"], "Entry");
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("references.bimcraft");
+        s.execute("save", &json!({"path":path})).unwrap();
+        let mut reopened = Session::new();
+        reopened.execute("open", &json!({"path":path})).unwrap();
+        assert_eq!(reopened.execute("elements", &json!({"category":"doors"})).unwrap(), before);
+        assert_eq!(reopened.model.check(), Ok(()));
+    }
+
+    #[test]
+    fn named_ids_and_array_results_attach_a_wall_and_delete_selected_grids() {
+        let mut s = Session::new();
+        let out = s
+            .script(
+                r#"level {"elevation":6000,"name":"Roof"}
+@roof = roof {"level":"Roof","boundary":[[0,0],[8000,0],[8000,6000],[0,6000]],"slope":10,"overhang":0}
+wall {"points":[[0,0],[8000,0]],"height":3000,"attach_top":"@roof"}
+@a = grid {"start":[0,0],"end":[0,4000]}
+@b = grid {"start":[2000,0],"end":[2000,4000]}
+delete {"ids":["@a","@b"]}"#,
+            )
+            .unwrap();
+        let wall = out[2]["ids"][0].as_u64().unwrap();
+        let Some(bimcraft_core::model::Element::Wall(wall)) = s.model.elements.get(wall) else { panic!("no wall") };
+        assert!(wall.attach_top.is_some_and(|guid| s.model.same(guid, out[1]["id"].as_u64().unwrap())));
+        assert_eq!(s.execute("elements", &json!({"category":"grid"})).unwrap()["count"], 0);
+    }
+
+    #[test]
+    fn external_command_results_resolve_nested_values_once_without_interpolating_keys() {
+        use bimcraft_core::engine::ExternalCommand;
+        use std::sync::Arc;
+        let mut s = Session::new();
+        s.register(ExternalCommand {
+            id: "plugin:reference:echo".into(),
+            label: "Echo".into(),
+            aliases: vec![],
+            params: "{}".into(),
+            menu: None,
+            plugin: "reference".into(),
+            run: Arc::new(|_, params| Ok(params.clone())),
+        })
+        .unwrap();
+        let out = s
+            .script(
+                r#"@first = plugin:reference:echo {"nested":{"items":[7,true,null,"@@literal"]}}
+plugin:reference:echo {"@key":{"values":["@first.nested.items","$last.nested.items.3"]}}"#,
+            )
+            .unwrap();
+        assert_eq!(out[1], json!({"@key":{"values":[[7,true,null,"@literal"],"@literal"]}}));
+        s.read_only = Some("read-only test");
+        assert!(s.script("@query = plugin:reference:echo {\"id\":42}\nplugin:reference:echo {\"value\":\"@query\"}").is_ok());
+    }
+
+    #[test]
+    fn relative_script_result_references_skip_comments_and_blank_lines() {
+        let mut s = Session::new();
+        s.script(
+            r#"grid {"start":[0,0],"end":[0,4000],"name":"A"}
+# not a result
+
+grid {"start":[2000,0],"end":[2000,4000],"name":"B"}
+modify {"id":"$last","name":"B1"}
+modify {"id":"$-3","name":"A1"}"#,
+        )
+        .unwrap();
+        let result = s.execute("elements", &json!({"category":"grid"})).unwrap();
+        assert_eq!(result["elements"][0]["name"], "A1");
+        assert_eq!(result["elements"][1]["name"], "B1");
+    }
+
+    #[test]
+    fn atomic_reference_errors_restore_history_ids_and_allow_a_clean_retry() {
+        let mut s = Session::new();
+        s.execute("grid", &json!({"start":[0,0],"end":[0,4000]})).unwrap();
+        s.execute("undo", &json!({})).unwrap();
+        let before = serde_json::to_value(&s.model).unwrap();
+        let history = s.history();
+        let history: Vec<String> = history.into_iter().map(str::to_owned).collect();
+        let redo = s.steps(true).len();
+        let e = s
+            .script_atomic(
+                r#"@walls = wall {"points":[[0,0],[8000,0]]}
+door {"wall":"@walls.ids.99","offset":3000}"#,
+            )
+            .unwrap_err();
+        assert!(e.starts_with("line 2 (door):") && e.contains("99"), "{e}");
+        assert_eq!(serde_json::to_value(&s.model).unwrap(), before);
+        assert_eq!(s.history(), history);
+        assert_eq!(s.steps(true).len(), redo);
+        s.script_atomic(
+            r#"@walls = wall {"points":[[0,0],[8000,0]]}
+door {"wall":"@walls.ids.0","offset":3000}"#,
+        )
+        .unwrap();
+        assert_eq!(s.history(), vec!["Script"]);
+        s.execute("undo", &json!({})).unwrap();
+        assert_eq!(serde_json::to_value(&s.model).unwrap(), before);
+        s.execute("redo", &json!({})).unwrap();
+        assert_eq!(s.execute("elements", &json!({"category":"doors"})).unwrap()["count"], 1);
+    }
+
+    #[test]
+    fn bad_references_name_the_failing_line_and_non_atomic_scripts_keep_prior_results() {
+        for (reference, message) in [
+            ("@missing", "no line before"),
+            ("$-5", "lines run before"),
+            ("$-0", "positive"),
+            ("$-nope", "positive"),
+            ("@walls", "no `id`"),
+            ("@walls.ids.8", "no `8`"),
+            ("@walls.nope", "no `nope`"),
+            ("@walls.ids.-1", "no `-1`"),
+            ("@walls.", "empty"),
+            ("@walls.ids..0", "empty"),
+        ] {
+            let mut s = Session::new();
+            let text = format!(
+                "@walls = wall {{\"points\":[[0,0],[8000,0]]}}\ndoor {{\"wall\":{reference:?},\"offset\":3000}}\nlevel {{\"elevation\":9000}}"
+            );
+            let e = s.script(&text).unwrap_err();
+            assert!(e.starts_with("line 2 (door):") && e.contains(reference) && e.contains(message), "{reference}: {e}");
+            assert_eq!(s.execute("elements", &json!({"category":"walls"})).unwrap()["count"], 1);
+            assert_eq!(s.model.levels().len(), 2, "the line after the failure never ran");
+            assert_eq!(s.history().len(), 1);
+            assert!(s.script("modify {\"id\":\"@walls.ids.0\"}").unwrap_err().contains("no line before"), "names are scoped to one script");
+        }
+    }
+
+    #[test]
+    fn named_lines_validate_names_and_allow_literal_at_and_dollar_text() {
+        for text in ["@ = inspect", "@bad.name = inspect", "@name inspect", "@name =", "@x = inspect\n@x = inspect"] {
+            let e = Session::new().script(text).unwrap_err();
+            assert!(e.starts_with("line ") && (e.contains("name") || e.contains("missing")), "{text}: {e}");
+        }
+        let mut s = Session::new();
+        s.script(
+            r#"text {"text":"@@hello","at":[0,0]}
+text {"text":"$$last","at":[0,100]}
+text {"text":"Email a@b and $5","at":[0,200]}"#,
+        )
+        .unwrap();
+        let notes = s.execute("elements", &json!({"category":"text"})).unwrap();
+        let texts: Vec<_> = notes["elements"].as_array().unwrap().iter().map(|e| e["text"].as_str().unwrap()).collect();
+        assert_eq!(texts, ["@hello", "$last", "Email a@b and $5"]);
+    }
+
+    #[test]
+    fn named_control_port_lines_cannot_replace_the_project_or_bypass_read_only() {
+        use bimcraft_core::bridge::{self, Access, Request};
+        let mut s = Session::new();
+        for atomic in [false, true] {
+            for name in ["new", "OPEN", "recover", "highrise", "tower"] {
+                let text = format!("wall {{\"points\":[[0,0],[8000,0]]}}\n@project = {name}");
+                let e = bridge::run(&mut s, &Request::Script { text, atomic, read_only: false }, Access::Edit).unwrap_err();
+                assert!(e.starts_with("line 2:") && e.contains("replace the project"), "{e}");
+                assert!(s.history().is_empty(), "bridge preflight must refuse before any line runs");
+            }
+            let text = "@walls = wall {\"points\":[[0,0],[8000,0]]}".to_owned();
+            let e = bridge::run(&mut s, &Request::Script { text, atomic, read_only: true }, Access::Edit).unwrap_err();
+            assert!(e.contains("read-only"), "{e}");
+            assert!(s.history().is_empty());
+        }
+        s.script("wall {\"points\":[[0,0],[8000,0]]}").unwrap();
+        let text =
+            "@all = elements {\"category\":\"walls\"}\nelements {\"level\":\"@all.elements.0.level\",\"category\":\"walls\"}".to_owned();
+        let results = bridge::run(&mut s, &Request::Script { text, atomic: true, read_only: true }, Access::Read).unwrap();
+        assert_eq!(results[1]["count"], 1);
+    }
+
+    #[test]
+    fn non_atomic_control_port_scripts_keep_completed_lines_before_a_malformed_name() {
+        use bimcraft_core::bridge::{self, Access, Request};
+        for atomic in [false, true] {
+            let mut s = Session::new();
+            let text = "wall {\"points\":[[0,0],[8000,0]]}\n@bad.name = inspect".to_owned();
+            let error = bridge::run(&mut s, &Request::Script { text, atomic, read_only: false }, Access::Edit).unwrap_err();
+            assert!(error.starts_with("line 2:") && error.contains("name"), "{error}");
+            assert_eq!(s.history().len(), usize::from(!atomic));
+        }
+    }
+    fn external_reply_session(reply: serde_json::Value) -> (Session, std::sync::Arc<std::sync::atomic::AtomicUsize>) {
+        use bimcraft_core::engine::ExternalCommand;
+        use std::sync::{
+            Arc,
+            atomic::{AtomicUsize, Ordering},
+        };
+        let mut s = Session::new();
+        let calls = Arc::new(AtomicUsize::new(0));
+        s.register(ExternalCommand {
+            id: "plugin:reference:source".into(),
+            label: "Source".into(),
+            aliases: vec![],
+            params: "{}".into(),
+            menu: None,
+            plugin: "reference".into(),
+            run: Arc::new(move |_, _| Ok(reply.clone())),
+        })
+        .unwrap();
+        let received = Arc::clone(&calls);
+        s.register(ExternalCommand {
+            id: "plugin:reference:accept".into(),
+            label: "Accept".into(),
+            aliases: vec![],
+            params: "{}".into(),
+            menu: None,
+            plugin: "reference".into(),
+            run: Arc::new(move |_, _| {
+                received.fetch_add(1, Ordering::SeqCst);
+                Ok(json!({"accepted":true}))
+            }),
+        })
+        .unwrap();
+        (s, calls)
+    }
+
+    #[test]
+    fn reference_expansion_budget_refuses_amplification_before_execution_and_rolls_back_for_retry() {
+        use std::sync::atomic::Ordering;
+        let (mut s, calls) = external_reply_session(json!({"payload":"x".repeat(16_384)}));
+        let before = serde_json::to_value(&s.model).unwrap();
+        let prefix = "wall {\"points\":[[0,0],[8000,0]]}\n@large = plugin:reference:source\n";
+        let text = format!("{prefix}plugin:reference:accept {}", json!({"copies":vec!["@large.payload";1100]}));
+        let result = s.script_atomic(&text);
+        assert!(result.is_err(), "unbounded expansion executed the recipient {} times", calls.load(Ordering::SeqCst));
+        let error = result.err().unwrap();
+        assert!(error.starts_with("line 3 (plugin:reference:accept):") && error.contains("16777216"), "{error}");
+        assert_eq!(calls.load(Ordering::SeqCst), 0);
+        assert_eq!(serde_json::to_value(&s.model).unwrap(), before);
+        assert!(s.history().is_empty());
+        s.script_atomic(&format!("{prefix}plugin:reference:accept {{\"copies\":[\"@large.payload\"]}}")).unwrap();
+        assert_eq!(calls.load(Ordering::SeqCst), 1);
+        assert_eq!(s.history(), vec!["Script"]);
+    }
+
+    #[test]
+    fn reference_expansion_diagnostics_do_not_copy_large_prior_replies() {
+        for reference in ["@large", "@large.missing"] {
+            let (mut s, _) = external_reply_session(json!({"payload":"private-payload".repeat(4096)}));
+            let error =
+                s.script(&format!("@large = plugin:reference:source\nplugin:reference:accept {}", json!({"value":reference}))).unwrap_err();
+            assert!(error.contains(reference));
+            assert!(error.len() < 1024, "reference diagnostic grew to {} bytes", error.len());
+            assert!(!error.contains("private-payload"));
+        }
+    }
+
+    #[test]
+    fn reference_expansion_rejects_deep_external_results_before_execution() {
+        use std::sync::atomic::Ordering;
+        let mut payload = json!(7);
+        for _ in 0..256 {
+            payload = json!([payload]);
+        }
+        let (mut s, calls) = external_reply_session(json!({"payload":payload}));
+        let result = s.script("@deep = plugin:reference:source\nplugin:reference:accept {\"value\":\"@deep.payload\"}");
+        assert!(result.is_err(), "an excessively nested external result reached the recipient");
+        let error = result.err().unwrap();
+        assert!(error.contains("128") && error.contains("depth"), "{error}");
+        assert_eq!(calls.load(Ordering::SeqCst), 0);
+    }
+
+    #[test]
+    fn reference_expansion_accepts_an_id_list_at_the_existing_command_cap() {
+        let mut s = Session::new();
+        let id = s.execute("grid", &json!({"start":[0,0],"end":[0,4000]})).unwrap()["id"].as_u64().unwrap();
+        let ids = vec![id; bimcraft_core::model::MAX_POINTS];
+        let script = "@list = plugin:reference:source\ndelete {\"ids\":\"@list.ids\"}";
+        let (mut receiver, _) = external_reply_session(json!({"ids":ids}));
+        receiver.execute("grid", &json!({"start":[0,0],"end":[0,4000]})).unwrap();
+        receiver.script(script).unwrap();
+        assert_eq!(receiver.execute("elements", &json!({"category":"grid"})).unwrap()["count"], 0);
+    }
+}
diff --git a/crates/core/tests/separator_wall_end.rs b/crates/core/tests/separator_wall_end.rs
new file mode 100644
index 00000000..1a1ba591
--- /dev/null
+++ b/crates/core/tests/separator_wall_end.rs
@@ -0,0 +1,191 @@
+//! A separator along a straight offset wall meets its end without moving the line; curved cap gaps stay open.
+#[cfg(test)]
+mod tests {
+    use bimcraft_core::engine::Session;
+    use bimcraft_core::step::{self, V};
+    use serde_json::{Value, json};
+
+    fn run(s: &mut Session, command: &str, params: Value) -> Value {
+        s.execute(command, &params).unwrap_or_else(|error| panic!("{command} {params}: {error}"))
+    }
+
+    fn fixture(start: [f64; 2], reversed: bool, rotated: bool, bounding: bool) -> Session {
+        let mut s = Session::new();
+        let point = |[x, y]: [f64; 2]| if rotated { [-y, x] } else { [x, y] };
+        let outer = [[0.0, 0.0], [9600.0, 0.0], [9600.0, 6400.0], [0.0, 6400.0]].map(point);
+        run(&mut s, "wall", json!({"points": outer, "closed": true}));
+        let mut partition = [[0.0, 3200.0], [4200.0, 3200.0]].map(point);
+        let mut separator = [start, [9500.0, 3200.0]].map(point);
+        if reversed {
+            partition.reverse();
+            separator.reverse();
+        }
+        run(
+            &mut s,
+            "wall",
+            json!({"points": partition, "location": if reversed {"interior-finish"} else {"exterior-finish"},
+                "room_bounding": bounding}),
+        );
+        run(&mut s, "room_separator", json!({"points": separator}));
+        for (at, name) in [([2000.0, 1600.0], "South"), ([2000.0, 4800.0], "North")] {
+            run(&mut s, "room", json!({"point": point(at), "name": name}));
+        }
+        s
+    }
+
+    fn rooms(s: &mut Session) -> Vec<Value> {
+        run(s, "elements", json!({"category": "room"}))["elements"].as_array().unwrap().clone()
+    }
+
+    fn assert_areas(s: &mut Session, at: &str, want: [f64; 2]) {
+        run(s, "room_area", json!({"at": at}));
+        let got = rooms(s);
+        assert_eq!(got.len(), 2, "{at}: {got:?}");
+        for (room, area) in got.iter().zip(want) {
+            assert_eq!(room["enclosed"], true, "{at}: {got:?}");
+            assert!(room.get("shares_space_with").is_none(), "{at}: {got:?}");
+            assert!((room["area_m2"].as_f64().unwrap() - area).abs() < 1e-6, "{at}: {got:?}");
+        }
+    }
+
+    #[test]
+    fn continuing_a_wall_end_separates_rooms_in_both_directions_and_on_rotated_plans() {
+        for reversed in [false, true] {
+            for rotated in [false, true] {
+                let mut s = fixture([4200.0, 3200.0], reversed, rotated, true);
+                // Centreline boundary: 4.2 m at y=3.1 m, a short cap, then 5.4 m at y=3.2 m.
+                assert_areas(&mut s, "centre", [30.30, 31.14]);
+                // Finish boundary deducts the 0.2 m partition's body, rather than sharing the gross areas.
+                assert_areas(&mut s, "finish", [28.32, 29.14]);
+                assert_eq!(run(&mut s, "elements", json!({"category": "roomseparator"}))["elements"][0]["length"], 5300.0);
+                assert_eq!(run(&mut s, "floor", json!({}))["area_m2"], 61.44, "separators do not split slabs");
+            }
+        }
+    }
+
+    #[test]
+    fn a_parallel_separator_does_not_join_a_gap_a_wall_side_or_a_nonbounding_wall() {
+        for (start, bounding) in [
+            ([4250.0, 3200.0], true), // A real gap beyond the end cap.
+            ([4100.0, 3200.0], true), // Along the wall's side, not its end.
+            ([4200.0, 3250.0], true), // Beside but outside its thickness.
+            ([4200.0, 3200.0], false),
+        ] {
+            let mut s = fixture(start, false, false, bounding);
+            let got = rooms(&mut s);
+            assert_eq!(got[0]["area_m2"], 61.44, "{start:?} {bounding}: {got:?}");
+            assert_eq!(got[1]["enclosed"], false, "{start:?} {bounding}: {got:?}");
+            assert_eq!(got[1]["shares_space_with"], got[0]["id"]);
+        }
+    }
+
+    #[test]
+    fn a_curved_wall_end_gap_is_not_closed_by_a_parallel_chord() {
+        let mut s = Session::new();
+        run(&mut s, "wall", json!({"points": [[0,0],[9600,0],[9600,6400],[0,6400]], "closed": true}));
+        run(&mut s, "wall", json!({"points": [[0,3200],[4200,3200]], "arc": 90, "location": "exterior-finish"}));
+        // The start is 2.533271 mm beyond the real end cap along its true 45-degree tangent.
+        // It is parallel to the final approximation chord, which must not supply a false cap connection.
+        let start = [4201.813986211087, 3201.7686006042572];
+        let end = [7461.151567268631, 6300.0];
+        run(&mut s, "room_separator", json!({"points": [start, end]}));
+        run(&mut s, "room", json!({"point": [2000,1600], "name": "South"}));
+        let north = run(&mut s, "room", json!({"point": [2000,4800], "name": "North"}));
+        assert_eq!(north["area_m2"], 0.0, "the real cap gap must stay open: {north}");
+        assert!(north["warning"].as_str().is_some_and(|warning| warning.contains("already in this space")), "{north}");
+        let got = rooms(&mut s);
+        assert_eq!(got.len(), 2);
+        assert_eq!(got[0]["area_m2"], 61.44, "{got:?}");
+        assert_eq!(got[1]["enclosed"], false, "{got:?}");
+        assert_eq!(got[1]["shares_space_with"], got[0]["id"]);
+        let separator = run(&mut s, "elements", json!({"category": "roomseparator"}));
+        assert_eq!(separator["elements"][0]["start"], json!(start));
+        assert_eq!(separator["elements"][0]["end"], json!(end));
+    }
+
+    #[test]
+    fn wall_end_rooms_survive_native_reopen_and_export_distinct_gross_and_net_ifc_quantities() {
+        let mut s = fixture([4200.0, 3200.0], false, false, true);
+        assert_areas(&mut s, "centre", [30.30, 31.14]);
+        let before = run(&mut s, "elements", json!({"category": "roomseparator"}));
+        let dir = tempfile::tempdir().unwrap();
+        let native = dir.path().join("separator-end.bimcraft");
+        let ifc = dir.path().join("separator-end.ifc");
+        run(&mut s, "save", json!({"path": native}));
+        let mut reopened = Session::new();
+        let opened = run(&mut reopened, "open", json!({"path": native}));
+        assert!(opened.get("left_out").is_none(), "{opened}");
+        assert_eq!(run(&mut reopened, "elements", json!({"category": "roomseparator"})), before);
+        assert_areas(&mut reopened, "centre", [30.30, 31.14]);
+        assert_areas(&mut reopened, "finish", [28.32, 29.14]);
+        run(&mut reopened, "save", json!({"path": ifc}));
+        let file = step::parse(&std::fs::read(&ifc).unwrap()).unwrap();
+        let spaces: Vec<_> = file.entities.values().filter(|e| e.name == "IFCSPACE").collect();
+        assert_eq!(spaces.len(), 2);
+        assert!(spaces.iter().all(|e| matches!(e.args.get(6), Some(V::Ref(_)))), "both spaces have real bodies");
+        for (name, mut want) in [("GrossFloorArea", vec![30.30, 31.14]), ("NetFloorArea", vec![28.32, 29.14])] {
+            let mut got: Vec<f64> = file
+                .entities
+                .values()
+                .filter(|e| e.name == "IFCQUANTITYAREA" && e.args.first() == Some(&V::Str(name.into())))
+                .map(|e| match e.args.get(3) {
+                    Some(V::Real(n)) => *n,
+                    Some(V::Int(n)) => *n as f64,
+                    value => panic!("unexpected area {value:?}"),
+                })
+                .collect();
+            got.sort_by(f64::total_cmp);
+            want.sort_by(f64::total_cmp);
+            assert_eq!(got, want, "{name}");
+        }
+        let mut imported = Session::new();
+        run(&mut imported, "open", json!({"path": ifc}));
+        assert_areas(&mut imported, "centre", [30.30, 31.14]);
+        assert_areas(&mut imported, "finish", [28.32, 29.14]);
+    }
+
+    #[test]
+    fn invalid_separator_commands_leave_the_existing_room_journey_intact() {
+        let mut s = fixture([4200.0, 3200.0], false, false, true);
+        assert_areas(&mut s, "centre", [30.30, 31.14]);
+        let before = s.model.clone();
+        for params in [
+            json!({"points": [[4200,3200]]}),
+            json!({"points": [[4200,3200],[4200,3200]]}),
+            json!({"points": [[4200,3200],[9500,3200]], "level": "Missing"}),
+            json!({"points": [[4200,3200],[1e30,3200]]}),
+        ] {
+            assert!(s.execute("room_separator", &params).is_err(), "{params}");
+            assert_eq!(s.model, before);
+        }
+        assert_areas(&mut s, "centre", [30.30, 31.14]);
+        assert_areas(&mut s, "finish", [28.32, 29.14]);
+    }
+
+    #[test]
+    fn rendered_plan_fills_both_independent_rooms_on_opposite_sides_of_the_partition() {
+        let mut s = fixture([4200.0, 3200.0], false, false, true);
+        let got = rooms(&mut s);
+        let colours = [[235, 130, 120], [120, 170, 235]];
+        for (room, colour) in got.iter().zip(colours) {
+            run(&mut s, "modify", json!({"id": room["id"], "colour": colour}));
+        }
+        let dir = tempfile::tempdir().unwrap();
+        let png = dir.path().join("rooms.png");
+        run(&mut s, "render", json!({"path": png, "width": 1000, "height": 800}));
+        let image = tiny_skia::Pixmap::decode_png(&std::fs::read(png).unwrap()).unwrap();
+        for (index, colour) in colours.into_iter().enumerate() {
+            let mut halves = [0, 0];
+            for y in 0..image.height() {
+                for x in 0..image.width() {
+                    let pixel = image.pixel(x, y).unwrap();
+                    if [pixel.red(), pixel.green(), pixel.blue()] == colour {
+                        halves[usize::from(y >= image.height() / 2)] += 1;
+                    }
+                }
+            }
+            assert!(halves[index ^ 1] > 20_000, "room {index} must have a visible fill: {halves:?}");
+            assert!(halves[index ^ 1] > halves[index] * 5, "room {index} must stay on its own side: {halves:?}");
+        }
+    }
+}
diff --git a/crates/core/tests/sheet_fit.rs b/crates/core/tests/sheet_fit.rs
new file mode 100644
index 00000000..52fae896
--- /dev/null
+++ b/crates/core/tests/sheet_fit.rs
@@ -0,0 +1,157 @@
+//! Default sheet scales exercised through the same commands as CLI and MCP users.
+#[cfg(test)]
+mod tests {
+    use bimcraft_core::engine::Session;
+    use bimcraft_core::model::Element;
+    use bimcraft_core::{render, sheet};
+    use serde_json::{Value, json};
+
+    fn building(width: f64, depth: f64) -> Session {
+        let mut s = Session::new();
+        s.execute("wall", &json!({"points": [[0, 0], [width, 0], [width, depth], [0, depth]], "closed": true})).unwrap();
+        s.execute("sheet", &json!({"number": "A101", "size": "A3", "name": "Synthetic 3D"})).unwrap();
+        s
+    }
+
+    fn viewport(s: &mut Session) -> Value {
+        s.execute("elements", &json!({"category": "viewport"})).unwrap()["elements"][0].clone()
+    }
+
+    #[test]
+    fn large_default_3d_view_fits_the_sheet_and_keeps_its_picture_after_save_and_reopen() {
+        let mut s = building(60000.0, 40000.0);
+        let placed = s.execute("place", &json!({"sheet": "A101", "view": "{3D}"})).unwrap();
+        let vp = viewport(&mut s);
+        assert_eq!(vp["scale"], 500.0, "a 1 : 100 picture would be 734 x 405 mm on A3");
+        assert_eq!(placed["scale"], vp["scale"], "the command reports the scale it chose");
+
+        let id = placed["id"].as_u64().unwrap();
+        let (frame, (x, y)) = sheet::frame(&s.model, id).unwrap();
+        // ISO A3: left 20, other borders 10, title box 40 mm high. Keep the frame and
+        // its title above the title box and inside all borders, in paper pixels.
+        assert!(x >= 25.0 * 5.0 && x + frame.width as f32 <= 405.0 * 5.0);
+        assert!(y >= 15.0 * 5.0 && y + frame.height as f32 + 15.0 * 5.0 <= 242.0 * 5.0);
+        let page = s.model.sheet_numbered("A101").unwrap();
+        let drawing = sheet::draw(&s.model, page).unwrap();
+        let png = render::png(&drawing).unwrap();
+        let pixels = tiny_skia::Pixmap::decode_png(&png).unwrap();
+        let border = pixels.pixel(100, 750).unwrap();
+        assert!(border.red() < 120 && border.green() < 120 && border.blue() < 120, "the view must not hide the left sheet border");
+        let picture = drawing
+            .prims
+            .iter()
+            .find_map(|p| match p {
+                render::Prim::Image { rgba, .. } => Some(rgba),
+                _ => None,
+            })
+            .unwrap();
+        assert!(
+            picture.as_chunks::<4>().0.iter().filter(|p| p[0] < 230 && p[1] < 230 && p[2] < 230).count() > 1000,
+            "the fitted view contains the building"
+        );
+
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("sheet.bimcraft");
+        s.execute("save", &json!({"path": path})).unwrap();
+        let mut reopened = Session::new();
+        let opened = reopened.execute("open", &json!({"path": path})).unwrap();
+        assert!(opened.get("left_out").is_none(), "{opened}");
+        assert_eq!(viewport(&mut reopened), vp, "the chosen viewport scale and position survive native save/open");
+        let page = reopened.model.sheet_numbered("A101").unwrap();
+        assert_eq!(render::png(&sheet::draw(&reopened.model, page).unwrap()).unwrap(), png);
+    }
+
+    #[test]
+    fn fitting_uses_the_current_standard_sheet_margins() {
+        // Seen horizontally, this model needs 379 mm at 1 : 200: ISO/JIS leave
+        // 380 mm after clearance; NBR leaves 378 and ANSI leaves 378.25 mm.
+        for (standard, expected) in [("iso", 200.0), ("eu", 200.0), ("jis", 200.0), ("nbr", 500.0), ("ansi", 500.0)] {
+            let mut s = building(60000.0, 40000.0);
+            s.execute("standard", &json!({"set": standard})).unwrap();
+            // ANSI adapts project units too; isolate its paper margins here.
+            s.execute("units", &json!({"length": "mm"})).unwrap();
+            s.execute("place", &json!({"sheet": "A101", "view": "{3D}", "elevation": 0, "azimuth": -45})).unwrap();
+            assert_eq!(viewport(&mut s)["scale"], expected, "{standard}");
+        }
+    }
+
+    #[test]
+    fn fitting_uses_the_finest_offered_imperial_scale_that_fits() {
+        let mut s = building(60000.0, 40000.0);
+        s.execute("units", &json!({"length": "in"})).unwrap();
+        s.execute("place", &json!({"sheet": "A101", "view": "{3D}"})).unwrap();
+        assert_eq!(viewport(&mut s)["scale"], 240.0, "the offered imperial scales are not sorted numerically");
+    }
+
+    #[test]
+    fn a_small_or_empty_3d_view_keeps_the_project_default_scale() {
+        for mut s in [building(8000.0, 6000.0), Session::new()] {
+            if s.model.sheet_numbered("A101").is_none() {
+                s.execute("sheet", &json!({"number": "A101"})).unwrap();
+            }
+            s.execute("place", &json!({"sheet": "A101", "view": "{3D}"})).unwrap();
+            assert_eq!(viewport(&mut s)["scale"], 100.0);
+        }
+    }
+
+    #[test]
+    fn explicit_viewport_scale_and_position_are_preserved_even_when_the_picture_does_not_fit() {
+        let mut s = building(60000.0, 40000.0);
+        s.execute("place", &json!({"sheet": "A101", "view": "{3D}", "scale": 100, "at": [10, 20]})).unwrap();
+        let vp = viewport(&mut s);
+        assert_eq!(vp["scale"], 100.0);
+        assert_eq!(vp["at"], json!([10.0, 20.0]));
+        assert!(vp["size"][0].as_f64().unwrap() > 420.0);
+    }
+
+    #[test]
+    fn explicit_position_is_preserved_when_a_default_3d_scale_is_fitted() {
+        let mut s = building(60000.0, 40000.0);
+        s.execute("place", &json!({"sheet": "A101", "view": "{3D}", "at": [90, 120]})).unwrap();
+        let vp = viewport(&mut s);
+        assert_eq!(vp["scale"], 500.0);
+        assert_eq!(vp["at"], json!([90.0, 120.0]));
+    }
+
+    #[test]
+    fn assigned_view_and_template_scales_are_preserved() {
+        for template in [false, true] {
+            let mut s = building(60000.0, 40000.0);
+            s.execute("visual_style", &json!({"style": "wireframe"})).unwrap();
+            let view = s.model.view_named("{3D}").unwrap();
+            if template {
+                s.execute("template", &json!({"name": "3D scale", "kind": "3d", "controls": ["scale"], "scale": 200})).unwrap();
+                s.execute("graphics", &json!({"view": view, "template": "3D scale"})).unwrap();
+            } else {
+                s.execute("modify", &json!({"id": view, "graphics": {"scale": 200}})).unwrap();
+            }
+            s.execute("place", &json!({"sheet": "A101", "view": view})).unwrap();
+            assert_eq!(viewport(&mut s)["scale"], 200.0, "template={template}");
+        }
+    }
+
+    #[test]
+    fn fitting_falls_back_to_the_coarsest_offered_scale_when_no_scale_fits() {
+        let mut s = building(900000.0, 600000.0);
+        s.execute("place", &json!({"sheet": "A101", "view": "{3D}"})).unwrap();
+        let vp = viewport(&mut s);
+        assert_eq!(vp["scale"], 1000.0);
+        assert!(vp["size"][0].as_f64().unwrap() > 420.0, "offered scales cannot fit every model");
+    }
+
+    #[test]
+    fn plans_keep_their_assigned_scale_instead_of_fitting_to_paper() {
+        let mut s = building(60000.0, 40000.0);
+        s.execute("scale", &json!({"view": "Level 1", "scale": 50})).unwrap();
+        s.execute("place", &json!({"sheet": "A101", "view": "Level 1"})).unwrap();
+        assert_eq!(viewport(&mut s)["scale"], 50.0);
+    }
+
+    #[test]
+    fn invalid_explicit_scale_does_not_leave_a_view_or_viewport_behind() {
+        let mut s = building(60000.0, 40000.0);
+        assert!(s.execute("place", &json!({"sheet": "A101", "view": "{3D}", "scale": 0})).is_err());
+        assert!(s.model.view_named("{3D}").is_none());
+        assert!(!s.model.elements.values().any(|e| matches!(e, Element::Viewport(_))));
+    }
+}
