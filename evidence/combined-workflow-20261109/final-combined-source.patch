+//! Grid exchange through the same commands as the CLI: save, inspect the STEP output and reopen.
+
+#[cfg(test)]
+mod tests {
+    use serde_json::{Value, json};
+
+    use bimcraft_core::engine::Session;
+    use bimcraft_core::step::{self, V};
+
+    fn run(s: &mut Session, command: &str, params: Value) -> Value {
+        s.execute(command, &params).unwrap_or_else(|e| panic!("{command}: {e}"))
+    }
+
+    fn grids(s: &mut Session) -> Vec<Value> {
+        run(s, "elements", json!({"category": "grid"}))["elements"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .map(|g| json!([g["name"], g["start"], g["end"]]))
+            .collect()
+    }
+
+    /// Inspect the exported entity graph independently of BIMCraft's importer.
+    fn axis_line(file: &step::File, axis: &V) -> Value {
+        let V::Ref(axis) = axis else { panic!("axis reference required") };
+        let axis = &file.entities[axis];
+        assert_eq!(axis.name, "IFCGRIDAXIS");
+        assert_eq!(axis.args[2], V::Enum("T".into()));
+        let V::Ref(curve) = &axis.args[1] else { panic!("curve reference required") };
+        let curve = &file.entities[curve];
+        assert_eq!(curve.name, "IFCPOLYLINE");
+        let V::List(points) = &curve.args[0] else { panic!("polyline points required") };
+        let coords: Vec<Value> = points
+            .iter()
+            .map(|p| {
+                let V::Ref(p) = p else { panic!("point reference required") };
+                let point = &file.entities[p];
+                assert_eq!(point.name, "IFCCARTESIANPOINT");
+                let V::List(coords) = &point.args[0] else { panic!("point coordinates required") };
+                assert_eq!(coords.len(), 2, "IFC grid curves must be two-dimensional");
+                json!(coords.iter().map(|v| if let V::Real(v) = v { *v } else { panic!("real coordinate required") }).collect::<Vec<_>>())
+            })
+            .collect();
+        assert_eq!(coords.len(), 2, "the axis is an open straight segment");
+        let V::Str(name) = &axis.args[0] else { panic!("axis tag required") };
+        json!([name, coords[0], coords[1]])
+    }
+
+    #[test]
+    fn ifc_grids_keep_native_names_and_oblique_lines_through_save_and_open() {
+        let mut s = Session::new();
+        run(&mut s, "grid", json!({"name": "U'1", "start": [-500,100], "end": [2500,4100]}));
+        run(&mut s, "grid", json!({"name": "U2", "start": [3500,4100], "end": [500,100]}));
+        run(&mut s, "grid", json!({"name": "V", "start": [0,2000], "end": [4000,-1000]}));
+        let expected = vec![
+            json!(["U'1", [-500.0, 100.0], [2500.0, 4100.0]]),
+            json!(["U2", [3500.0, 4100.0], [500.0, 100.0]]),
+            json!(["V", [0.0, 2000.0], [4000.0, -1000.0]]),
+        ];
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("grids.ifc");
+        run(&mut s, "save", json!({"path": path}));
+        let text = std::fs::read_to_string(&path).unwrap();
+        let f = step::parse(text.as_bytes()).unwrap();
+        let grid = f.entities.values().find(|e| e.name == "IFCGRID").expect("native grids must be exported");
+        let (V::List(u), V::List(v)) = (&grid.args[7], &grid.args[8]) else { panic!("U and V axis lists required") };
+        assert_eq!(u.iter().map(|a| axis_line(&f, a)).collect::<Vec<_>>(), expected[..2]);
+        assert_eq!(v.iter().map(|a| axis_line(&f, a)).collect::<Vec<_>>(), expected[2..]);
+        assert_eq!(f.entities.values().filter(|e| e.name == "IFCGRIDAXIS").count(), 3);
+        let mut reopened = Session::new();
+        run(&mut reopened, "open", json!({"path": path}));
+        assert_eq!(grids(&mut reopened), expected);
+    }
+
+    // A deliberately shared U/V axis, accepted kindly from external files. Its parent placement is translated,
+    // its own turned 90 degrees; SameSense reverses the endpoints after that placement.
+    const SHARED_AXIS_GRID: &str = "ISO-10303-21;HEADER;FILE_SCHEMA(('IFC4'));ENDSEC;DATA;
+#1=IFCCARTESIANPOINT((100.,200.,0.));
+#2=IFCAXIS2PLACEMENT3D(#1,$,$);
+#3=IFCLOCALPLACEMENT($,#2);
+#4=IFCCARTESIANPOINT((10.,20.,0.));
+#5=IFCDIRECTION((0.,1.,0.));
+#6=IFCAXIS2PLACEMENT3D(#4,$,#5);
+#7=IFCLOCALPLACEMENT(#3,#6);
+#8=IFCCARTESIANPOINT((1.,2.));
+#9=IFCCARTESIANPOINT((4.,6.));
+#10=IFCPOLYLINE((#8,#9));
+#11=IFCGRIDAXIS('A',#10,.F.);
+#12=IFCGRID('0000000000000000000012',$,'Grid',$,$,#7,$,(#11),(#11),$,.IRREGULAR.);
+#13=IFCSIUNIT(*,.LENGTHUNIT.,.MILLI.,.METRE.);
+#14=IFCUNITASSIGNMENT((#13));
+#15=IFCPROJECT('0000000000000000000015',$,'Shared axis',$,$,$,$,$,#14);
+ENDSEC;END-ISO-10303-21;";
+
+    #[test]
+    fn ifc_grids_import_a_shared_axis_once_and_keep_reversed_sense_and_placement() {
+        let imported = bimcraft_core::import::ifc(SHARED_AXIS_GRID.as_bytes(), "Shared axis").unwrap();
+        let mut s = Session::new();
+        s.model = imported.model.into();
+        assert_eq!(grids(&mut s), vec![json!(["A", [104.0, 224.0], [108.0, 221.0]])]);
+    }
+
+    #[test]
+    fn ifc_grids_import_keeps_distinct_coincident_axes_w_axes_and_axes_in_different_placements() {
+        let text = SHARED_AXIS_GRID.replace("(#11),(#11),$", "(#11),(#16),(#17)").replace(
+            "ENDSEC;END-ISO-10303-21;",
+            "#16=IFCGRIDAXIS('B',#10,.T.);
+#17=IFCGRIDAXIS('C',#10,.T.);
+#18=IFCGRID('0000000000000000000018',$,'Other',$,$,#3,$,(#11),(#11),$,.IRREGULAR.);
+ENDSEC;END-ISO-10303-21;",
+        );
+        let imported = bimcraft_core::import::ifc(text.as_bytes(), "Distinct axes").unwrap();
+        let mut s = Session::new();
+        s.model = imported.model.into();
+        assert_eq!(
+            grids(&mut s),
+            vec![
+                json!(["A", [104.0, 224.0], [108.0, 221.0]]),
+                json!(["B", [108.0, 221.0], [104.0, 224.0]]),
+                json!(["C", [108.0, 221.0], [104.0, 224.0]]),
+                json!(["A (2)", [104.0, 206.0], [101.0, 202.0]]),
+            ]
+        );
+    }
+
+    #[test]
+    fn ifc_grids_unrelated_annotations_do_not_become_grids_and_missing_axes_are_reported() {
+        let text = SHARED_AXIS_GRID.replace(
+            "#12=IFCGRID('0000000000000000000012',$,'Grid',$,$,#7,$,(#11),(#11),$,.IRREGULAR.);",
+            "#12=IFCANNOTATION('0000000000000000000012',$,'Broken',$,'BIMCraft_GridAxis',#7,$);
+#16=IFCANNOTATION('0000000000000000000016',$,'Ordinary',$,'Other',#7,$);",
+        );
+        let imported = bimcraft_core::import::ifc(text.as_bytes(), "Annotations").unwrap();
+        assert!(imported.skipped.iter().any(|s| s.contains("its grid annotation has no axis")), "{:?}", imported.skipped);
+        let mut s = Session::new();
+        s.model = imported.model.into();
+        assert!(grids(&mut s).is_empty());
+    }
+
+    #[test]
+    fn ifc_grids_parallel_axes_use_real_disjoint_axis_sets_and_reopen_once() {
+        let mut s = Session::new();
+        for x in [0, 1000, 2000] {
+            run(&mut s, "grid", json!({"start": [x,0], "end": [x,3000]}));
+        }
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("parallel.ifc");
+        run(&mut s, "save", json!({"path": path}));
+        let text = std::fs::read_to_string(&path).unwrap();
+        let f = step::parse(text.as_bytes()).unwrap();
+        let grid = f.entities.values().find(|e| e.name == "IFCGRID").expect("parallel grids must be exported");
+        let (V::List(u), V::List(v)) = (&grid.args[7], &grid.args[8]) else { panic!("U and V must be nonempty lists") };
+        assert!(!u.is_empty() && !v.is_empty());
+        assert!(u.iter().all(|axis| !v.contains(axis)), "no axis belongs to both U and V");
+        assert_eq!(f.entities.values().filter(|e| e.name == "IFCGRIDAXIS").count(), 3, "no invented axes");
+        let mut reopened = Session::new();
+        run(&mut reopened, "open", json!({"path": path}));
+        assert_eq!(
+            grids(&mut reopened),
+            vec![
+                json!(["1", [0.0, 0.0], [0.0, 3000.0]]),
+                json!(["2", [1000.0, 0.0], [1000.0, 3000.0]]),
+                json!(["3", [2000.0, 0.0], [2000.0, 3000.0]])
+            ]
+        );
+    }
+
+    #[test]
+    fn ifc_grids_a_lone_axis_is_a_named_curve_annotation_and_reopens_as_a_grid() {
+        let mut s = Session::new();
+        let added = run(&mut s, "grid", json!({"name": "Solo", "start": [100,200], "end": [3100,4200]}));
+        let expected_guid = json!(s.model.guid(added["id"].as_u64().unwrap()));
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("solo.ifc");
+        run(&mut s, "save", json!({"path": path}));
+        let text = std::fs::read_to_string(&path).unwrap();
+        let f = step::parse(text.as_bytes()).unwrap();
+        assert!(!f.entities.values().any(|e| e.name == "IFCGRID" || e.name == "IFCGRIDAXIS"), "no dummy or repeated axes");
+        let annotation = f.entities.values().find(|e| e.name == "IFCANNOTATION").expect("a lone grid is exported as a curve annotation");
+        assert_eq!(annotation.args[2], V::Str("Solo".into()));
+        assert_eq!(annotation.args[4], V::Str("BIMCraft_GridAxis".into()));
+        let mut reopened = Session::new();
+        run(&mut reopened, "open", json!({"path": path}));
+        assert_eq!(grids(&mut reopened), vec![json!(["Solo", [100.0, 200.0], [3100.0, 4200.0]])]);
+        // An annotation has a GlobalId, so this fallback can retain the native element's identity too.
+        let back = run(&mut reopened, "elements", json!({"category": "grid"}));
+        assert_eq!(back["elements"][0]["guid"], expected_guid);
+    }
+
+    #[test]
+    fn ifc_grids_without_native_grids_write_no_grid_entities_or_annotations() {
+        let text = bimcraft_core::ifc::export(&Session::new().model);
+        let f = step::parse(text.as_bytes()).unwrap();
+        assert!(!f.entities.values().any(|e| matches!(e.name.as_str(), "IFCGRID" | "IFCGRIDAXIS" | "IFCANNOTATION")));
+    }
+}
diff --git a/crates/core/tests/ifc_supplementary_quantities.rs b/crates/core/tests/ifc_supplementary_quantities.rs
new file mode 100644
index 00000000..73d774b3
--- /dev/null
+++ b/crates/core/tests/ifc_supplementary_quantities.rs
@@ -0,0 +1,232 @@
+//! Quantities seen by a consumer after commands, native save/reopen and IFC export.
+#[cfg(test)]
+mod tests {
+    use std::collections::BTreeMap;
+
+    use bimcraft_core::engine::Session;
+    use bimcraft_core::step::{self, V};
+    use serde_json::json;
+
+    fn exported(script: &str) -> step::File {
+        let mut session = Session::new();
+        session.script(script).unwrap();
+        let dir = tempfile::tempdir().unwrap();
+        let native = dir.path().join("quantities.bimcraft");
+        let ifc = dir.path().join("quantities.ifc");
+        session.execute("save", &json!({"path":native})).unwrap();
+        let mut reopened = Session::new();
+        reopened.execute("open", &json!({"path":native})).unwrap();
+        reopened.execute("save", &json!({"path":ifc})).unwrap();
+        step::parse(&std::fs::read(ifc).unwrap()).unwrap()
+    }
+
+    fn quantities(f: &step::File, class: &str, name: &str) -> BTreeMap<String, f64> {
+        let product = f.entities.iter().find(|(_, e)| e.name == class).unwrap().0;
+        let set = f.entities.values().find_map(|r| {
+            if r.name != "IFCRELDEFINESBYPROPERTIES" || r.args[4] != V::List(vec![V::Ref(*product)]) {
+                return None;
+            }
+            let V::Ref(id) = r.args[5] else { return None };
+            let set = &f.entities[&id];
+            (set.name == "IFCELEMENTQUANTITY" && set.args[2] == V::Str(name.into())).then_some(set)
+        });
+        let set = set.unwrap_or_else(|| panic!("{class} is missing {name}"));
+        let V::List(qs) = &set.args[5] else { panic!("quantity list") };
+        qs.iter()
+            .map(|q| {
+                let V::Ref(id) = q else { panic!("quantity reference") };
+                let q = &f.entities[id];
+                let V::Str(name) = &q.args[0] else { panic!("quantity name") };
+                let value = match q.args[3] {
+                    V::Real(v) => v,
+                    V::Int(v) => v as f64,
+                    _ => panic!("quantity value"),
+                };
+                (name.clone(), value)
+            })
+            .collect()
+    }
+
+    fn near(q: &BTreeMap<String, f64>, name: &str, expected: f64) {
+        let actual = q.get(name).unwrap_or_else(|| panic!("missing {name}: {q:?}"));
+        // STEP's existing real-number writer rounds to six decimal places.
+        assert!((actual - expected).abs() < 0.000_000_51, "{name}: {actual}, expected {expected}");
+    }
+
+    #[test]
+    fn ceiling_areas_subtract_openings_and_only_intersecting_shafts() {
+        let f = exported(
+            r#"
+type {"category":"ceiling","name":"Test ceiling","thickness":20}
+ceiling {"type":"Test ceiling","boundary":[[0,0],[4000,0],[4000,3000],[0,3000]],"openings":[[[500,500],[1500,500],[1500,1500],[500,1500]]]}
+shaft {"boundary":[[2000,500],[3000,500],[3000,1500],[2000,1500]],"height":5000}
+shaft {"boundary":[[2000,2000],[3000,2000],[3000,2500],[2000,2500]],"height":1000}
+"#,
+        );
+        let q = quantities(&f, "IFCCOVERING", "Qto_CoveringBaseQuantities");
+        near(&q, "Width", 20.0);
+        near(&q, "GrossArea", 12.0);
+        near(&q, "NetArea", 10.0);
+    }
+
+    #[test]
+    fn roof_areas_follow_the_pitch_and_subtract_openings_and_shafts() {
+        let f = exported(
+            r#"
+roof {"level":100001,"boundary":[[0,0],[4000,0],[4000,3000],[0,3000]],"slope":30,"overhang":0,"openings":[[[500,500],[1500,500],[1500,1500],[500,1500]]]}
+shaft {"boundary":[[2500,500],[3500,500],[3500,1500],[2500,1500]],"height":10000}
+"#,
+        );
+        let q = quantities(&f, "IFCROOF", "Qto_RoofBaseQuantities");
+        near(&q, "GrossArea", 12.0 / 30_f64.to_radians().cos());
+        near(&q, "NetArea", 10.0 / 30_f64.to_radians().cos());
+        near(&q, "ProjectedArea", 12.0);
+    }
+
+    #[test]
+    fn shaped_variable_layer_roof_areas_follow_the_top_planes() {
+        let f = exported(
+            r#"
+type {"category":"roof","name":"Variable roof","layers":[{"function":"substrate","thickness":200,"variable":true}]}
+roof {"level":100001,"type":"Variable roof","boundary":[[0,0],[4000,0],[4000,4000],[0,4000]],"slope":0,"overhang":0}
+edit_shape {"id":100002,"points":[{"at":[2000,2000],"z":-100}]}
+"#,
+        );
+        let q = quantities(&f, "IFCROOF", "Qto_RoofBaseQuantities");
+        let area = 16.0 * (1.0_f64 + 0.05 * 0.05).sqrt();
+        near(&q, "GrossArea", area);
+        near(&q, "NetArea", area);
+        near(&q, "ProjectedArea", 16.0);
+    }
+
+    #[test]
+    fn roof_courtyard_is_absent_from_gross_and_projected_areas() {
+        let f = exported(
+            r#"
+roof {"boundary":[[0,0],[4000,0],[4000,3000],[0,3000]],"slope":0,"overhang":0,"courtyards":[[[1000,1000],[2000,1000],[2000,2000],[1000,2000]]]}
+"#,
+        );
+        let q = quantities(&f, "IFCROOF", "Qto_RoofBaseQuantities");
+        for n in ["GrossArea", "NetArea", "ProjectedArea"] {
+            near(&q, n, 11.0);
+        }
+    }
+
+    #[test]
+    fn pad_footing_dimensions_and_volume_match_its_rectangular_solid() {
+        let f = exported(
+            r#"
+type {"category":"footing","name":"Test pad","width":1200,"depth":1000}
+footing {"type":"Test pad","at":[0,0],"thickness":400,"offset":-200,"angle":30}
+"#,
+        );
+        let q = quantities(&f, "IFCFOOTING", "Qto_FootingBaseQuantities");
+        near(&q, "Length", 1200.0);
+        near(&q, "Width", 1000.0);
+        near(&q, "Height", 400.0);
+        near(&q, "GrossVolume", 0.48);
+        near(&q, "NetVolume", 0.48);
+    }
+
+    #[test]
+    fn round_pad_uses_the_circle_area_and_strip_uses_its_run_length() {
+        let f = exported(
+            r#"
+type {"category":"footing","name":"Round pad","width":1000,"round":true}
+footing {"type":"Round pad","at":[0,0],"thickness":400}
+"#,
+        );
+        let q = quantities(&f, "IFCFOOTING", "Qto_FootingBaseQuantities");
+        near(&q, "Width", 1000.0);
+        near(&q, "GrossVolume", std::f64::consts::PI * 0.1);
+        near(&q, "NetVolume", std::f64::consts::PI * 0.1);
+        let f = exported(
+            r#"
+type {"category":"stripfooting","name":"Test strip","width":600,"depth":300}
+strip_footing {"type":"Test strip","points":[[0,0],[4000,0]]}
+"#,
+        );
+        let q = quantities(&f, "IFCFOOTING", "Qto_FootingBaseQuantities");
+        near(&q, "Length", 4000.0);
+        near(&q, "Width", 600.0);
+        near(&q, "Height", 300.0);
+        near(&q, "CrossSectionArea", 0.18);
+        near(&q, "GrossVolume", 0.72);
+        near(&q, "NetVolume", 0.72);
+    }
+
+    #[test]
+    fn extruded_roof_projected_area_comes_from_its_profile_instead_of_its_boundary() {
+        let f = exported(
+            r#"
+roof {"level":100001,"extrusion":{"line":[[0,0],[4000,0]],"profile":[[0,0],[2000,1000],[4000,0]],"from":0,"to":3000}}
+"#,
+        );
+        let q = quantities(&f, "IFCROOF", "Qto_RoofBaseQuantities");
+        near(&q, "ProjectedArea", 12.0);
+        near(&q, "GrossArea", 12.0 * 1.25_f64.sqrt());
+        near(&q, "NetArea", 12.0 * 1.25_f64.sqrt());
+    }
+
+    #[test]
+    fn wall_base_attached_to_a_slope_subtracts_only_the_door_above_its_base() {
+        let f = exported(
+            r#"
+type {"category":"wall","name":"Test wall","thickness":200}
+type {"category":"door","name":"Test door","width":1000,"height":2000}
+floor {"boundary":[[-500,-500],[4500,-500],[4500,500],[-500,500]],"slope":14.036243467926479,"arrow":[[0,0],[4000,0]]}
+wall {"type":"Test wall","points":[[0,0],[4000,0]],"height":6000,"attach_base":100002}
+door {"type":"Test door","wall":100003,"offset":1000}
+"#,
+        );
+        let q = quantities(&f, "IFCWALL", "Qto_WallBaseQuantities");
+        near(&q, "GrossSideArea", 22.0);
+        near(&q, "NetSideArea", 20.25);
+        near(&q, "GrossVolume", 4.4);
+        near(&q, "NetVolume", 4.05);
+        assert!(!q.contains_key("Height"));
+    }
+
+    #[test]
+    fn wall_attached_across_a_roof_ridge_measures_both_planes() {
+        let f = exported(
+            r#"
+type {"category":"wall","name":"Test wall","thickness":200}
+type {"category":"door","name":"Test door","width":1000,"height":2000}
+roof {"level":100001,"extrusion":{"line":[[0,0],[4000,0]],"profile":[[0,0],[2000,1000],[4000,0]],"from":0,"to":1000}}
+wall {"type":"Test wall","points":[[0,500],[4000,500]],"attach_top":100002}
+door {"type":"Test door","wall":100003,"offset":1000}
+"#,
+        );
+        let q = quantities(&f, "IFCWALL", "Qto_WallBaseQuantities");
+        near(&q, "GrossSideArea", 14.0);
+        near(&q, "NetSideArea", 12.0);
+        near(&q, "GrossVolume", 2.8);
+        near(&q, "NetVolume", 2.4);
+        assert!(!q.contains_key("Height"));
+    }
+
+    #[test]
+    fn attached_wall_quantities_integrate_the_sloping_top_and_clipped_door() {
+        let f = exported(
+            r#"
+type {"category":"wall","name":"Test wall","thickness":200}
+type {"category":"floor","name":"Test floor","thickness":200}
+type {"category":"door","name":"Tall door","width":1000,"height":5000}
+floor {"type":"Test floor","boundary":[[-500,-500],[4500,-500],[4500,500],[-500,500]],"offset":3000,"slope":14.036243467926479,"arrow":[[0,0],[4000,0]]}
+wall {"type":"Test wall","points":[[0,0],[4000,0]],"attach_top":100002}
+door {"type":"Tall door","wall":100003,"offset":1000}
+"#,
+        );
+        let q = quantities(&f, "IFCWALL", "Qto_WallBaseQuantities");
+        // The floor's 200 mm thickness is normal to its slope, so its underside is 200/cos(slope) below its top.
+        let underside = 3000.0 - 200.0 * (1.0_f64 + 0.25 * 0.25).sqrt();
+        let gross = 4.0 * (underside + 500.0) / 1000.0;
+        let cut = (underside + 250.0) / 1000.0;
+        near(&q, "GrossSideArea", gross);
+        near(&q, "NetSideArea", gross - cut);
+        near(&q, "GrossVolume", gross * 0.2);
+        near(&q, "NetVolume", (gross - cut) * 0.2);
+        assert!(!q.contains_key("Height"), "a varying height must not be reported as a single height");
+    }
+}
diff --git a/crates/core/tests/ifc_wall_authoring.rs b/crates/core/tests/ifc_wall_authoring.rs
new file mode 100644
index 00000000..7be80e20
--- /dev/null
+++ b/crates/core/tests/ifc_wall_authoring.rs
@@ -0,0 +1,222 @@
+//! Wall location and attachment intent survive the same save/open commands used by CLI and MCP clients.
+#[cfg(test)]
+mod tests {
+    use bimcraft_core::engine::Session;
+    use bimcraft_core::model::{Element, Guid, Location, Wall};
+    use serde_json::json;
+
+    fn walls(s: &Session) -> Vec<(Guid, Wall)> {
+        s.model
+            .elements
+            .with_guids()
+            .filter_map(|(_, guid, e)| match e {
+                Element::Wall(w) => Some((guid, w.clone())),
+                _ => None,
+            })
+            .collect()
+    }
+
+    fn reopen(s: &mut Session, extension: &str) -> Session {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join(format!("authoring.{extension}"));
+        s.execute("save", &json!({"path":path})).unwrap();
+        let mut read = Session::new();
+        let opened = read.execute("open", &json!({"path":path})).unwrap();
+        assert!(opened.get("left_out").is_none_or(|v| v.as_array().is_none_or(Vec::is_empty)), "{opened}");
+        assert!(opened.get("skipped").is_none_or(|v| v.as_array().is_none_or(Vec::is_empty)), "{opened}");
+        read
+    }
+
+    fn export(s: &mut Session) -> String {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("wall.ifc");
+        s.execute("save", &json!({"path":path})).unwrap();
+        std::fs::read_to_string(path).unwrap()
+    }
+
+    fn open_ifc(text: &str) -> Session {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("external.ifc");
+        std::fs::write(&path, text).unwrap();
+        let mut read = Session::new();
+        read.execute("open", &json!({"path":path})).unwrap();
+        read
+    }
+
+    fn roof_wall() -> Session {
+        let mut s = Session::new();
+        s.script(
+            r#"wall {"points":[[0,0],[5000,0]],"height":2800}
+            roof {"boundary":[[-500,-500],[5500,-500],[5500,3500],[-500,3500]],"gable":true}
+            modify {"id":100002,"attach_top":100003}"#,
+        )
+        .unwrap();
+        s
+    }
+
+    #[test]
+    fn noncentral_location_lines_keep_the_drawn_endpoints_through_ifc_and_native_reopen() {
+        let mut s = Session::new();
+        s.script(r#"type {"category":"wall","name":"Layered","layers":[{"function":"finish","material":"Brick","thickness":40},{"function":"structure","material":"Concrete","thickness":180},{"function":"finish","material":"Plaster","thickness":20}]}"#).unwrap();
+        for (i, location) in Location::ALL.into_iter().enumerate() {
+            for (j, arc) in [0, 45, -60].into_iter().enumerate() {
+                let y = (i * 3 + j) as f64 * 4000.0;
+                let points = if j == 2 { json!([[4200, y], [200, y]]) } else { json!([[200, y], [4200, y]]) };
+                s.execute("wall", &json!({"points":points,"type":"Layered","location":location.name(),"arc":arc})).unwrap();
+            }
+        }
+        let expected = walls(&s);
+        let mut read = reopen(&mut s, "ifc");
+        for (guid, wall) in expected {
+            let actual = read.model.elements.get(guid).unwrap();
+            let Element::Wall(actual) = actual else { panic!("wall") };
+            assert_eq!(actual.location, wall.location, "location line for {guid}");
+            assert!(actual.start.dist(wall.start) < 0.002 && actual.end.dist(wall.end) < 0.002, "drawn endpoints for {guid}: {actual:?}");
+            assert!((actual.arc - wall.arc).abs() < 0.00001);
+        }
+        assert_eq!(walls(&read), walls(&reopen(&mut read, "bimcraft")));
+    }
+
+    #[test]
+    fn floor_attachments_keep_their_guids_after_ifc_and_native_reopen() {
+        let mut s = Session::new();
+        s.script(
+            r#"level {"name":"Upper","elevation":4000}
+            floor {"boundary":[[-1000,-1000],[6000,-1000],[6000,3000],[-1000,3000]],"offset":400}
+            floor {"level":"Upper","boundary":[[-1000,-1000],[6000,-1000],[6000,3000],[-1000,3000]]}
+            wall {"points":[[0,0],[5000,0]],"location":"exterior-finish","height":2800}
+            modify {"id":100005,"attach_base":100003,"attach_top":100004}"#,
+        )
+        .unwrap();
+        let expected = walls(&s);
+        let mut read = reopen(&mut s, "ifc");
+        for (guid, wall) in expected {
+            let Element::Wall(actual) = read.model.elements.get(guid).unwrap() else { panic!("wall") };
+            assert_eq!(actual.attach_top, wall.attach_top, "top attachment");
+            assert_eq!(actual.attach_base, wall.attach_base, "base attachment");
+            assert_eq!(actual.location, wall.location, "location line");
+            assert!(actual.start.dist(wall.start) < 0.002 && actual.end.dist(wall.end) < 0.002);
+        }
+        assert_eq!(walls(&read), walls(&reopen(&mut read, "bimcraft")));
+    }
+
+    #[test]
+    fn authored_endpoints_near_another_wall_are_not_extended_by_import_joining() {
+        let mut s = Session::new();
+        s.script(
+            r#"wall {"points":[[0,0],[4000,0]],"height":2800}
+            wall {"points":[[3950,50],[3950,4000]],"height":2800,"location":"interior-finish"}"#,
+        )
+        .unwrap();
+        let expected = walls(&s);
+        let read = reopen(&mut s, "ifc");
+        for (guid, wall) in expected {
+            let Element::Wall(actual) = read.model.elements.get(guid).unwrap() else { panic!("wall") };
+            assert_eq!((actual.start, actual.end, actual.location), (wall.start, wall.end, wall.location));
+        }
+    }
+
+    #[test]
+    fn explicit_roof_attachment_and_explicitly_unattached_metadata_override_the_geometry_guess() {
+        let mut s = roof_wall();
+        let (guid, original) = walls(&s).remove(0);
+        let file = export(&mut s);
+        let read = open_ifc(&file);
+        assert_eq!(read.model.wall(guid).unwrap().attach_top, original.attach_top);
+        // An external edit leaves the body alone but says the wall is no longer attached.
+        let unattached = file.replace("'AttachTop'", "'OtherProperty'");
+        let read = open_ifc(&unattached);
+        assert_eq!(read.model.wall(guid).unwrap().attach_top, None);
+        // Without BIMCraft's metadata, the original generic roof inference remains available.
+        let generic = file.replace("'BIMCraft_Wall'", "'Other_Wall'");
+        let read = open_ifc(&generic);
+        assert_eq!(read.model.wall(guid).unwrap().attach_top, original.attach_top);
+    }
+
+    #[test]
+    fn unknown_or_nontext_location_metadata_keeps_the_generic_body_reconstruction() {
+        let mut s = Session::new();
+        s.execute("wall", &json!({"points":[[0,0],[5000,0]],"location":"exterior-finish","height":2800})).unwrap();
+        let (guid, _) = walls(&s).remove(0);
+        let file = export(&mut s);
+        let generic = open_ifc(&file.replace("'BIMCraft_Wall'", "'Other_Wall'"));
+        let expected = generic.model.wall(guid).unwrap();
+        for value in ["IFCTEXT('future-location')", "IFCINTEGER(7)", "$"] {
+            let read = open_ifc(&file.replace("IFCTEXT('exterior-finish')", value));
+            let actual = read.model.wall(guid).unwrap();
+            assert_eq!((actual.start, actual.end, actual.location), (expected.start, expected.end, Location::Centre));
+        }
+    }
+
+    #[test]
+    fn missing_or_wrong_kind_attachment_targets_leave_the_wall_present_and_unattached() {
+        let mut s = roof_wall();
+        let (guid, original) = walls(&s).remove(0);
+        let file = export(&mut s);
+        let target = bimcraft_core::ifc::compress(original.attach_top.unwrap().as_u128());
+        let level = bimcraft_core::ifc::compress(original.level.as_u128());
+        for value in ["invalid".to_string(), level, bimcraft_core::ifc::compress(123)] {
+            let read = open_ifc(&file.replace(&format!("IFCIDENTIFIER('{target}')"), &format!("IFCIDENTIFIER('{value}')")));
+            assert_eq!(read.model.wall(guid).unwrap().attach_top, None);
+        }
+    }
+
+    #[test]
+    fn reversed_layer_usage_keeps_the_generic_direction_and_centre_line() {
+        let mut s = Session::new();
+        s.script(r#"type {"category":"wall","name":"Layered","layers":[{"function":"finish","material":"Brick","thickness":40},{"function":"structure","material":"Concrete","thickness":180}]}
+            wall {"points":[[0,0],[5000,0]],"type":"Layered","location":"exterior-finish","height":2800}"#).unwrap();
+        let (guid, _) = walls(&s).remove(0);
+        let file = export(&mut s).replace(".AXIS2.,.NEGATIVE.", ".AXIS2.,.POSITIVE.");
+        let generic = open_ifc(&file.replace("'BIMCraft_Wall'", "'Other_Wall'"));
+        let read = open_ifc(&file);
+        let (actual, expected) = (read.model.wall(guid).unwrap(), generic.model.wall(guid).unwrap());
+        assert_eq!((actual.start, actual.end, actual.location), (expected.start, expected.end, Location::Centre));
+        assert!(actual.start.0 > actual.end.0);
+    }
+
+    #[test]
+    fn opening_wall_metadata_with_many_unknown_properties_and_targets_keeps_only_the_real_wall_intent() {
+        let mut s = roof_wall();
+        let (guid, expected) = walls(&s).remove(0);
+        let file = export(&mut s);
+        let parsed = bimcraft_core::step::parse(file.as_bytes()).unwrap();
+        let wall = *parsed.entities.iter().find(|(_, e)| e.name == "IFCWALL").unwrap().0;
+        let roof = *parsed.entities.iter().find(|(_, e)| e.name == "IFCROOF").unwrap().0;
+        let mut next = parsed.entities.keys().max().unwrap() + 1;
+        let mut extra = String::new();
+        let mut properties = Vec::new();
+        // Bounded synthetic amplification probe: 1024 unused values and 1024 distinct missing targets, plus a real
+        // non-wall target. Keep the actual wall last so a target-list cutoff cannot accidentally pass this journey.
+        for i in 0..1024 {
+            extra.push_str(&format!("#{next}=IFCPROPERTYSINGLEVALUE('Unused{i}',$,IFCTEXT('ignored'),$);\n"));
+            properties.push(format!("#{next}"));
+            next += 1;
+        }
+        for (name, value) in
+            [("Location", "centre".to_string()), ("AttachTop", bimcraft_core::ifc::compress(expected.attach_top.unwrap().as_u128()))]
+        {
+            extra.push_str(&format!("#{next}=IFCPROPERTYSINGLEVALUE('{name}',$,IFCTEXT('{value}'),$);\n"));
+            properties.push(format!("#{next}"));
+            next += 1;
+        }
+        let set = next;
+        extra.push_str(&format!("#{set}=IFCPROPERTYSET('0AAAAAAAAAAAAAAAAAAAAA',$,'BIMCraft_Wall',$,({}));\n", properties.join(",")));
+        let mut targets: Vec<String> = (0..1024).map(|i| format!("#{}", 1_000_000 + i)).collect();
+        targets.extend([format!("#{roof}"), format!("#{wall}")]);
+        extra.push_str(&format!(
+            "#{}=IFCRELDEFINESBYPROPERTIES('0BBBBBBBBBBBBBBBBBBBBB',$,$,$,({}),#{set});\n",
+            set + 1,
+            targets.join(",")
+        ));
+        let file = file.replacen("ENDSEC;\nEND-ISO-10303-21;", &format!("{extra}ENDSEC;\nEND-ISO-10303-21;"), 1);
+        assert!(file.contains("Unused1023"));
+        let mut read = open_ifc(&file);
+        let actual = read.model.wall(guid).unwrap();
+        assert_eq!((actual.location, actual.attach_top, actual.attach_base), (expected.location, expected.attach_top, None));
+        assert_eq!((actual.start, actual.end), (expected.start, expected.end));
+        assert_eq!(walls(&read).len(), 1);
+        assert_eq!(read.execute("elements", &json!({"category":"wall"})).unwrap()["count"], 1);
+        assert_eq!(walls(&read), walls(&reopen(&mut read, "bimcraft")));
+    }
+}
diff --git a/crates/core/tests/industrial_doors.rs b/crates/core/tests/industrial_doors.rs
new file mode 100644
index 00000000..400c2779
--- /dev/null
+++ b/crates/core/tests/industrial_doors.rs
@@ -0,0 +1,230 @@
+//! Industrial gates through the same commands used by the CLI and MCP.
+#[cfg(test)]
+mod tests {
+    use bimcraft_core::engine::Session;
+    use bimcraft_core::model::{Element, Model};
+    use bimcraft_core::render::{self, Prim, View};
+    use serde_json::{Value, json};
+
+    fn gate(operation: &str) -> (Session, u64) {
+        let mut s = Session::new();
+        s.execute("wall", &json!({"points": [[0,0],[12000,0]], "height": 4500})).unwrap();
+        s.execute("type", &json!({"category":"door", "name":"Gate", "width":3000, "height":3200, "operation":operation})).unwrap();
+        let door = s.execute("door", &json!({"at":[3500,0], "type":"Gate"})).unwrap()["id"].as_u64().unwrap();
+        (s, door)
+    }
+
+    #[test]
+    fn sectional_and_roller_gates_save_reopen_and_keep_operations_and_guids() {
+        for (operation, label, ifc) in [("sectional", "Sectional", ".USERDEFINED."), ("roller", "Roller", ".ROLLINGUP.")] {
+            let (mut s, door) = gate(operation);
+            let schedule = s.execute("schedule", &json!({"category":"doors", "fields":["Operation", "Width", "Height"]})).unwrap();
+            assert_eq!(schedule["rows"], json!([[label, 3000.0, 3200.0]]));
+            let dir = tempfile::tempdir().unwrap();
+            let path = dir.path().join("gate.bimcraft");
+            s.execute("save", &json!({"path":path})).unwrap();
+            let mut back = Session::new();
+            let opened = back.execute("open", &json!({"path":path})).unwrap();
+            assert!(opened["left_out"].is_null() || opened["left_out"] == json!([]));
+            assert_eq!(back.model.elements.guid(door), s.model.elements.guid(door));
+            assert_eq!(back.model.library, s.model.library);
+            assert_eq!(back.model.types, s.model.types);
+            let path = dir.path().join("gate.ifc");
+            back.execute("save", &json!({"path":path})).unwrap();
+            let step = std::fs::read_to_string(&path).unwrap();
+            for class in ["=IFCDOOR(", "=IFCDOORTYPE("] {
+                assert!(step.lines().any(|line| line.contains(class) && line.contains(ifc)), "{class}: {operation}");
+            }
+            if operation == "sectional" {
+                assert_eq!(
+                    step.lines().filter(|l| (l.contains("=IFCDOOR(") || l.contains("=IFCDOORTYPE(")) && l.contains("'SECTIONAL'")).count(),
+                    2
+                );
+            }
+            let guid = s.model.elements.guid(door).unwrap();
+            back.execute("open", &json!({"path":path})).unwrap();
+            let imported = back.model.elements.get(guid).unwrap();
+            assert!(matches!(imported, Element::Door(_)));
+            assert_eq!(back.model.opening_type(imported).unwrap().operation.unwrap().name(), operation);
+            assert_eq!(back.model.opening_type(imported).unwrap().width, 3000.0);
+            assert_eq!(back.model.opening_type(imported).unwrap().height, 3200.0);
+        }
+    }
+
+    #[test]
+    fn vertical_gates_have_a_closed_panel_in_plan_without_a_horizontal_swing() {
+        for operation in ["sectional", "roller"] {
+            let (mut s, door) = gate(operation);
+            let level = s.model.levels()[0].0;
+            let view = View { scale: 0.08, cx: 6000.0, cy: 0.0, width: 1100, height: 650 };
+            for (hand, facing) in [(false, false), (true, false), (false, true), (true, true)] {
+                s.execute("modify", &json!({"id":door,"flip_hand":hand,"flip_facing":facing})).unwrap();
+                let drawing = render::draw(&s.model, level, view);
+                let lines: Vec<_> = drawing
+                    .prims
+                    .iter()
+                    .zip(&drawing.owners)
+                    .filter_map(|(p, id)| {
+                        if *id == Some(door)
+                            && let Prim::Line { pts, dash, .. } = p
+                        {
+                            return Some((pts, dash));
+                        }
+                        None
+                    })
+                    .collect();
+                assert!(lines.len() >= 3, "jambs and panel must be drawn");
+                assert!(lines.iter().any(|(_, dash)| dash.is_some()), "tracks or coil box are dashed overhead");
+                for (points, dash) in lines {
+                    assert!(points.len() < 10, "a vertical gate must have no swing arc");
+                    if dash.is_none() {
+                        for point in points {
+                            assert!(view.mm(*point).1.abs() <= 181.0, "cut gate parts stay at the wall face: {:?}", view.mm(*point));
+                        }
+                    }
+                }
+                assert!(!render::png(&drawing).unwrap().is_empty());
+                let scene = bimcraft_core::view3d::Scene::new(&s.model);
+                let camera = scene.fit(-90.0, 15.0, 500, 400);
+                let picture = scene.render(&camera, &[]);
+                assert!(
+                    (0..picture.height).any(|y| (0..picture.width).any(|x| picture.pick(f64::from(x), f64::from(y)) == Some(door))),
+                    "the closed gate must remain visible and pickable in 3D"
+                );
+            }
+        }
+    }
+
+    #[test]
+    fn gate_type_edits_keep_host_validation_and_rollback() {
+        let (mut s, door) = gate("sectional");
+        let original = s.model.elements[&door].clone();
+        let before = (*s.model).clone();
+        let error = s.execute("type", &json!({"category":"door","name":"Gate","width":13000,"operation":"roller"})).unwrap_err();
+        assert!(error.contains("wall"), "{error}");
+        assert_eq!(*s.model, before);
+        s.execute("type", &json!({"category":"door","name":"Gate","operation":"roller"})).unwrap();
+        assert_eq!(s.model.elements[&door], original);
+        assert_eq!(s.model.types.door["Gate"].operation.unwrap().name(), "roller");
+        let before = (*s.model).clone();
+        assert!(s.execute("type", &json!({"category":"door","name":"Gate","operation":"spinning"})).is_err());
+        assert_eq!(*s.model, before);
+        assert!(s.execute("door", &json!({"at":[3500,0],"type":"Gate"})).is_err(), "overlapping gates remain invalid");
+        assert_eq!(*s.model, before);
+    }
+
+    #[test]
+    fn old_files_keep_unspecified_swing_and_newer_files_are_refused() {
+        let mut s = Session::new();
+        s.execute("type", &json!({"category":"door","name":"Legacy","width":900,"height":2100})).unwrap();
+        let mut file: Value = serde_json::from_str(&s.model.to_json().unwrap()).unwrap();
+        file["format"] = json!(17);
+        let (back, left_out) = Model::read(&file.to_string()).unwrap();
+        assert!(left_out.is_empty());
+        assert_eq!(back.types.door["Legacy"].operation, None);
+        assert_eq!(back.library, s.model.library);
+        assert_eq!(back.elements, s.model.elements);
+        file["format"] = json!(bimcraft_core::model::FORMAT + 1);
+        assert!(Model::read(&file.to_string()).unwrap_err().contains("newer BIMCraft"));
+    }
+
+    #[test]
+    fn family_operations_keep_authored_geometry_and_import_from_ifc_type_fallback() {
+        for (operation, ifc) in [("sectional", ".USERDEFINED."), ("roller", ".ROLLINGUP.")] {
+            let mut s = Session::new();
+            let original = s.model.families["Single Door"].clone();
+            s.execute("family", &json!({"name":"Single Door","operation":operation})).unwrap();
+            let family = &s.model.families["Single Door"];
+            assert_eq!(family.forms, original.forms);
+            assert_eq!(family.symbols, original.symbols);
+            s.script("wall {\"points\":[[0,0],[8000,0]]}\ndoor {\"at\":[2000,0],\"family\":\"Single Door\"}").unwrap();
+            let step = bimcraft_core::ifc::export(&s.model);
+            let user = if operation == "sectional" { "'SECTIONAL'" } else { "$" };
+            let typed = step.replacen(&format!("{ifc},{user})"), "$,$)", 1);
+            assert_ne!(step, typed, "remove occurrence operation so the imported type supplies it");
+            let back = bimcraft_core::import::ifc(typed.as_bytes(), "Gate").unwrap();
+            let door = back.model.elements.values().find(|e| matches!(e, Element::Door(_))).unwrap();
+            assert_eq!(back.model.opening_type(door).unwrap().operation.unwrap().name(), operation);
+        }
+    }
+
+    #[test]
+    fn existing_operations_and_handedness_keep_their_ifc_meaning() {
+        for (operation, left, right) in [
+            ("swing", ".SINGLE_SWING_LEFT.", ".SINGLE_SWING_RIGHT."),
+            ("double-swing", ".DOUBLE_DOOR_SINGLE_SWING.", ".DOUBLE_DOOR_SINGLE_SWING."),
+            ("sliding", ".SLIDING_TO_LEFT.", ".SLIDING_TO_RIGHT."),
+            ("double-sliding", ".DOUBLE_DOOR_SLIDING.", ".DOUBLE_DOOR_SLIDING."),
+            ("folding", ".FOLDING_TO_LEFT.", ".FOLDING_TO_RIGHT."),
+            ("fixed", ".NOTDEFINED.", ".NOTDEFINED."),
+        ] {
+            let (mut s, door) = gate(operation);
+            for (hand, expected) in [(false, left), (true, right)] {
+                s.execute("modify", &json!({"id":door,"flip_hand":hand})).unwrap();
+                let step = bimcraft_core::ifc::export(&s.model);
+                assert!(step.lines().any(|l| l.contains("=IFCDOOR(") && l.contains(expected)), "{operation}: {expected}");
+            }
+        }
+    }
+
+    #[test]
+    fn industrial_parts_have_positive_volume_and_fit_in_plan_with_overhead_equipment() {
+        for (operation, count, reach, top) in [("sectional", 9, 3380.0, 3300.0), ("roller", 4, 550.0, 3650.0)] {
+            let (mut s, door) = gate(operation);
+            for facing in [false, true] {
+                s.execute("modify", &json!({"id":door,"flip_facing":facing})).unwrap();
+                let pieces = s.model.opening_pieces(&s.model.elements[&door]);
+                assert_eq!(pieces.len(), count);
+                let pts: Vec<_> = pieces.iter().flat_map(|p| p.tris.iter().flatten()).collect();
+                let highest = pts.iter().map(|p| p[2]).fold(f64::NEG_INFINITY, f64::max);
+                let furthest = pts.iter().map(|p| p[1].abs()).fold(0.0, f64::max);
+                assert!((highest - top).abs() < 1e-8 && (furthest - reach).abs() < 1e-8);
+                for piece in pieces {
+                    let volume = piece
+                        .tris
+                        .iter()
+                        .map(|[a, b, c]| {
+                            a[0] * (b[1] * c[2] - b[2] * c[1]) + a[1] * (b[2] * c[0] - b[0] * c[2]) + a[2] * (b[0] * c[1] - b[1] * c[0])
+                        })
+                        .sum::<f64>()
+                        / 6.0;
+                    assert!(volume > 0.0, "mirrored parts must keep outward faces");
+                }
+                let drawing = render::plan(&s.model, s.model.levels()[0].0, 900, 400);
+                for (p, owner) in drawing.prims.iter().zip(&drawing.owners) {
+                    if *owner == Some(door) {
+                        for (x, y) in p.points() {
+                            assert!((0.0..900.0).contains(&x) && (0.0..400.0).contains(&y), "Zoom to Fit clipped the gate: {x},{y}");
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn flipped_industrial_gates_reopen_on_the_same_side_of_the_wall_in_ifc() {
+        for operation in ["sectional", "roller"] {
+            let (mut s, door) = gate(operation);
+            s.execute("modify", &json!({"id":door,"flip_facing":true,"flip_hand":true})).unwrap();
+            let step = bimcraft_core::ifc::export(&s.model);
+            let back = bimcraft_core::import::ifc(step.as_bytes(), "Gate").unwrap();
+            let original_guid = s.model.elements.guid(door).unwrap();
+            let imported = back.model.elements.get(original_guid).unwrap();
+            assert!(matches!(imported, Element::Door(o) if o.flip_facing));
+            let before = s.model.opening_pieces(&s.model.elements[&door]);
+            let after = back.model.opening_pieces(imported);
+            for k in 0..3 {
+                let extent = |pieces: &[bimcraft_core::family::Piece]| {
+                    pieces
+                        .iter()
+                        .flat_map(|p| p.tris.iter().flatten())
+                        .map(|p| p[k])
+                        .fold((f64::INFINITY, f64::NEG_INFINITY), |(lo, hi), v| (lo.min(v), hi.max(v)))
+                };
+                let (a, b) = (extent(&before), extent(&after));
+                assert!((a.0 - b.0).abs() < 0.01 && (a.1 - b.1).abs() < 0.01, "{operation}, coordinate {k}: {a:?} vs {b:?}");
+            }
+        }
+    }
+}
diff --git a/crates/core/tests/legacy_georeference.rs b/crates/core/tests/legacy_georeference.rs
new file mode 100644
index 00000000..c3d0347f
--- /dev/null
+++ b/crates/core/tests/legacy_georeference.rs
@@ -0,0 +1,131 @@
+//! A native file's identifiable legacy georeference survives open, save and IFC exchange.
+
+#[cfg(test)]
+mod tests {
+    use bimcraft_core::engine::Session;
+    use bimcraft_core::model::FORMAT;
+    use serde_json::{Value, json};
+
+    fn run(s: &mut Session, command: &str, params: Value) -> Value {
+        s.execute(command, &params).unwrap_or_else(|e| panic!("{command}: {e}"))
+    }
+
+    fn project(georeference: Value) -> Value {
+        let mut s = Session::new();
+        run(&mut s, "wall", json!({"points": [[0, 0], [8000, 0]], "height": 3000}));
+        let mut value: Value = serde_json::from_str(&s.model.to_json().unwrap()).unwrap();
+        value["georeference"] = georeference;
+        value
+    }
+
+    fn legacy() -> Value {
+        json!({"crs": "EPSG:32632", "eastings": 500_000_000, "northings": 5_000_000_000.0,
+            "orthogonal_height": 42_000, "rotation": 30})
+    }
+
+    #[test]
+    fn legacy_height_and_clockwise_rotation_survive_native_and_ifc_reopen() {
+        for scale in [None, Some(0.9996)] {
+            let dir = tempfile::tempdir().unwrap();
+            let input = dir.path().join("legacy.bimcraft");
+            let native = dir.path().join("current.bimcraft");
+            let ifc = dir.path().join("current.ifc");
+            let mut geo = legacy();
+            if let Some(scale) = scale {
+                geo["scale"] = json!(scale);
+            }
+            let source = project(geo);
+            std::fs::write(&input, source.to_string()).unwrap();
+            let mut s = Session::new();
+            let opened = run(&mut s, "open", json!({"path": input}));
+            let g = s.model.georeference.as_ref().unwrap();
+            assert_eq!(g.height, 42_000.0, "opening legacy height must not silently zero it");
+            assert_eq!(g.rotation, -30.0, "legacy clockwise becomes counterclockwise");
+            assert_eq!(g.scale, scale.unwrap_or(1.0));
+            assert!(opened.get("left_out").is_none_or(|v| v.as_array().is_some_and(Vec::is_empty)), "{opened}");
+            let expected = g.clone();
+            let ids: Vec<_> = s.model.elements.with_guids().map(|(id, guid, _)| (id, guid)).collect();
+            run(&mut s, "save", json!({"path": native}));
+            run(&mut s, "save", json!({"path": ifc}));
+            let saved: Value = serde_json::from_str(&std::fs::read_to_string(&native).unwrap()).unwrap();
+            assert!(saved["georeference"].get("orthogonal_height").is_none());
+            let mut reopened = Session::new();
+            run(&mut reopened, "open", json!({"path": native}));
+            assert_eq!(reopened.model.georeference.as_ref(), Some(&expected));
+            assert_eq!(ids, reopened.model.elements.with_guids().map(|(id, guid, _)| (id, guid)).collect::<Vec<_>>());
+            run(&mut reopened, "open", json!({"path": ifc}));
+            let imported = reopened.model.georeference.as_ref().unwrap();
+            assert!((imported.height - expected.height).abs() < 1e-6);
+            assert!((imported.rotation - expected.rotation).abs() < 1e-8);
+            assert!((imported.scale - expected.scale).abs() < 1e-12);
+        }
+    }
+
+    #[test]
+    fn modern_fields_and_unknown_field_reporting_are_preserved() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("input.bimcraft");
+        for old in [false, true] {
+            let mut geo = legacy();
+            if !old {
+                geo.as_object_mut().unwrap().remove("orthogonal_height");
+                geo["height"] = json!(42_000);
+            }
+            geo["scale"] = json!(1.0002);
+            geo["future_metadata"] = json!("retained in left_out report");
+            std::fs::write(&path, project(geo).to_string()).unwrap();
+            let mut s = Session::new();
+            let report = run(&mut s, "open", json!({"path": path}));
+            assert_eq!(report["left_out"], json!(["/georeference/future_metadata"]));
+            let g = s.model.georeference.as_ref().unwrap();
+            assert_eq!((g.height, g.rotation, g.scale), (42_000.0, if old { -30.0 } else { 30.0 }, 1.0002));
+        }
+    }
+
+    #[test]
+    fn conflicting_invalid_and_newer_payloads_leave_the_open_project_unchanged() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("refused.bimcraft");
+        let mut s = Session::new();
+        run(&mut s, "wall", json!({"points": [[0, 0], [4000, 0]]}));
+        let before = s.model.to_json().unwrap();
+        let mut cases = Vec::new();
+        let mut both = legacy();
+        both["height"] = json!(42_000);
+        cases.push(project(both));
+        for (key, invalid) in [("orthogonal_height", json!("bad")), ("rotation", json!("30")), ("scale", json!(0))] {
+            let mut geo = legacy();
+            geo[key] = invalid;
+            cases.push(project(geo));
+        }
+        for value in cases {
+            std::fs::write(&path, value.to_string()).unwrap();
+            assert!(s.execute("open", &json!({"path": path})).is_err(), "must refuse ambiguous, invalid or newer georeference input");
+            assert_eq!(s.model.to_json().unwrap(), before);
+        }
+        let mut newer = project(legacy());
+        newer["format"] = json!(FORMAT + 1);
+        newer["georeference"]["height"] = json!("ambiguous and invalid");
+        std::fs::write(&path, newer.to_string()).unwrap();
+        let error = s.execute("open", &json!({"path": path})).unwrap_err();
+        assert!(error.contains("newer BIMCraft"), "version guard must precede migration: {error}");
+        assert_eq!(s.model.to_json().unwrap(), before);
+        std::fs::write(&path, project(legacy()).to_string()).unwrap();
+        s.read_only = Some("read-only migration acceptance");
+        assert!(s.execute("open", &json!({"path": path})).is_err());
+        assert_eq!(s.model.to_json().unwrap(), before);
+    }
+
+    #[test]
+    fn absent_legacy_rotation_and_scale_keep_the_existing_defaults() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("defaults.bimcraft");
+        let mut geo = legacy();
+        geo.as_object_mut().unwrap().remove("rotation");
+        std::fs::write(&path, project(geo).to_string()).unwrap();
+        let mut s = Session::new();
+        run(&mut s, "open", json!({"path": path}));
+        let g = s.model.georeference.as_ref().unwrap();
+        assert_eq!((g.height, g.rotation, g.scale), (42_000.0, 0.0, 1.0));
+    }
+}
