+//! Open-stair user journeys through the CLI/MCP command interface.
+#[cfg(test)]
+mod tests {
+    use bimcraft_core::engine::Session;
+    use serde_json::{Value, json};
+
+    fn stair(s: &mut Session, id: u64) -> Value {
+        s.execute("elements", &json!({"category":"stair"})).unwrap()["elements"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .find(|v| v["id"] == id)
+            .unwrap()
+            .clone()
+    }
+
+    #[test]
+    fn open_construction_survives_native_and_ifc_save_reopen_and_can_be_closed_again() {
+        let mut s = Session::new();
+        let id = s
+            .execute(
+                "stair",
+                &json!({"start":[0,0],"height":2880,"open":true,
+            "landings":[{"at":8,"turn":90}],"railings":true}),
+            )
+            .unwrap()["id"]
+            .as_u64()
+            .unwrap();
+        assert_eq!(stair(&mut s, id)["open"], true, "creating an open stair must not silently create solid construction");
+        let guid = stair(&mut s, id)["guid"].clone();
+        for extension in ["bimcraft", "ifc"] {
+            let path = std::env::temp_dir().join(format!("bimcraft-open-stair-{}.{extension}", std::process::id()));
+            s.execute("save", &json!({"path":path})).unwrap();
+            let mut reopened = Session::new();
+            reopened.execute("open", &json!({"path":path})).unwrap();
+            let value = reopened.execute("elements", &json!({"category":"stair"})).unwrap()["elements"][0].clone();
+            assert_eq!(value["open"], true, "{extension} must keep open construction");
+            assert_eq!(value["guid"], guid, "stair identity survives {extension}");
+            assert_eq!(value["risers"], 16);
+            assert_eq!(value["landings"][0]["turn"], 90.0);
+            let reopened_id = value["id"].as_u64().unwrap();
+            reopened.execute("modify", &json!({"id":reopened_id,"open":false})).unwrap();
+            assert_ne!(stair(&mut reopened, reopened_id)["open"], true);
+            std::fs::remove_file(path).unwrap();
+        }
+    }
+
+    // Sample the actual mesh sent to the desktop renderer, not private stair helper state.
+    fn heights(s: &Session, id: u64, point: [f64; 2]) -> (f64, f64) {
+        use bimcraft_core::{
+            graphics::Look,
+            view3d::{Scene, gpu::Mesh},
+        };
+        let mesh = Mesh::flat(&Scene::new(&s.model), &Look::of_3d(&s.model)).unwrap();
+        let mut z = Vec::new();
+        for tri in mesh.vertices.as_chunks::<3>().0 {
+            if tri[0].owner == 0 || mesh.owners[tri[0].owner as usize - 1].id != id {
+                continue;
+            }
+            let p: Vec<[f64; 3]> = tri.iter().map(|v| std::array::from_fn(|k| f64::from(v.position[k]) + mesh.origin[k])).collect();
+            let [x, y] = point;
+            let d = (p[1][1] - p[2][1]) * (p[0][0] - p[2][0]) + (p[2][0] - p[1][0]) * (p[0][1] - p[2][1]);
+            if d.abs() < 1e-8 {
+                continue;
+            }
+            let a = ((p[1][1] - p[2][1]) * (x - p[2][0]) + (p[2][0] - p[1][0]) * (y - p[2][1])) / d;
+            let b = ((p[2][1] - p[0][1]) * (x - p[2][0]) + (p[0][0] - p[2][0]) * (y - p[2][1])) / d;
+            let c = 1.0 - a - b;
+            if a >= -1e-6 && b >= -1e-6 && c >= -1e-6 {
+                z.push(a * p[0][2] + b * p[1][2] + c * p[2][2]);
+            }
+        }
+        assert!(!z.is_empty(), "stair mesh must cover {point:?}");
+        (z.iter().copied().fold(f64::INFINITY, f64::min), z.iter().copied().fold(f64::NEG_INFINITY, f64::max))
+    }
+
+    fn close(a: f64, b: f64) {
+        assert!((a - b).abs() < 0.02, "expected {b}, got {a}");
+    }
+
+    #[test]
+    fn treads_supports_and_landing_underside_survive_ifc_reopening() {
+        for (case, angle, turn) in [(0, 0.0_f64, 0), (1, 37.0, 90), (2, 90.0, -90), (3, 180.0, 180), (4, -31.0, -180)] {
+            let mut s = Session::new();
+            let id = s
+                .execute(
+                    "stair",
+                    &json!({"start":[200,300],"angle":angle,"height":2880,"open":true,
+                "landings":[{"at":8,"turn":turn}]}),
+                )
+                .unwrap()["id"]
+                .as_u64()
+                .unwrap();
+            let (sin, cos) = angle.to_radians().sin_cos();
+            let point = |x: f64, y: f64| [200.0 + x * cos - y * sin, 300.0 + x * sin + y * cos];
+            let check = |s: &Session, id| {
+                let centre = heights(s, id, point(980.0, 0.0));
+                close(centre.0, 680.0);
+                close(centre.1, 720.0);
+                for side in [-494.0, 494.0] {
+                    let support = heights(s, id, point(980.0, side));
+                    close(support.0, 520.0);
+                    close(support.1, 770.0);
+                }
+                let pad = heights(s, id, point(2460.0, 0.0));
+                close(pad.0, 1190.0);
+                close(pad.1, 1440.0);
+            };
+            check(&s, id);
+            let path = std::env::temp_dir().join(format!("bimcraft-open-mesh-{}-{case}.ifc", std::process::id()));
+            s.execute("save", &json!({"path":path})).unwrap();
+            let mut reopened = Session::new();
+            reopened.execute("open", &json!({"path":path})).unwrap();
+            let v = reopened.execute("elements", &json!({"category":"stair"})).unwrap();
+            assert_eq!(v["count"], 1);
+            check(&reopened, v["elements"][0]["id"].as_u64().unwrap());
+            std::fs::remove_file(path).unwrap();
+        }
+    }
+
+    #[test]
+    fn two_riser_open_flights_keep_their_direction_and_height_on_ifc_import() {
+        // A single tread cannot establish the run direction from tread centres. In the shallow
+        // case the stringer's sloped top also points almost upward, but it is not a tread.
+        for (height, riser, tread) in [(720.0, 180.0, 280.0), (200.0, 50.0, 1000.0)] {
+            let mut s = Session::new();
+            s.execute(
+                "stair",
+                &json!({"start":[100,200],"angle":33,"height":height,"riser":riser,"tread":tread,"open":true,
+                "landings":[{"at":2,"turn":90}]}),
+            )
+            .unwrap();
+            let path = std::env::temp_dir().join(format!("bimcraft-short-open-{}.ifc", std::process::id()));
+            s.execute("save", &json!({"path":path})).unwrap();
+            s.execute("open", &json!({"path":path})).unwrap();
+            let v = s.execute("elements", &json!({"category":"stair"})).unwrap()["elements"][0].clone();
+            assert_eq!(v["open"], true);
+            assert_eq!(v["risers"], 4);
+            close(v["angle"].as_f64().unwrap(), 33.0);
+            close(v["width"].as_f64().unwrap(), 1000.0);
+            close(v["tread"].as_f64().unwrap(), tread);
+            close(v["height"].as_f64().unwrap(), height);
+            std::fs::remove_file(path).unwrap();
+        }
+    }
+
+    #[test]
+    fn format18_stairs_keep_solid_geometry_guids_and_unknown_field_reporting() {
+        use bimcraft_core::model::{FORMAT, Model};
+        let mut s = Session::new();
+        let id = s.execute("stair", &json!({"start":[0,0],"height":2880,"landings":[{"at":8,"turn":90}]})).unwrap()["id"].as_u64().unwrap();
+        let original = bimcraft_core::ifc::export(&s.model);
+        let mut file: Value = serde_json::from_str(&s.model.to_json().unwrap()).unwrap();
+        file["format"] = json!(18);
+        file["elements"][id.to_string()]["future_note"] = json!("left out");
+        let (m, left) = Model::read(&file.to_string()).unwrap();
+        assert_eq!(m.format, FORMAT);
+        assert_eq!(m.elements.guid(id), s.model.elements.guid(id));
+        assert_eq!(m.library, s.model.library, "migration preserves library identities and references");
+        assert_eq!(left, vec![format!("/elements/{id}/future_note")]);
+        assert_eq!(
+            bimcraft_core::ifc::export(&m).split_once("DATA;").unwrap().1,
+            original.split_once("DATA;").unwrap().1,
+            "migration must not change closed IFC geometry or GUIDs"
+        );
+        file["format"] = json!(FORMAT + 1);
+        assert!(Model::read(&file.to_string()).unwrap_err().contains("newer BIMCraft"));
+        assert_eq!(heights(&s, id, [980.0, 0.0]).0, 0.0);
+    }
+
+    #[test]
+    fn invalid_open_parameters_roll_back_and_modify_undo_preserves_identity() {
+        let mut s = Session::new();
+        let id = s.execute("stair", &json!({"start":[0,0],"height":2880})).unwrap()["id"].as_u64().unwrap();
+        let before = s.model.to_json().unwrap();
+        for params in [
+            json!({"start":[0,0],"open":"yes"}),
+            json!({"start":[0,0],"open":true,"width":30}),
+            json!({"start":[0,0],"open":true,"height":80,"riser":40}),
+        ] {
+            assert!(s.execute("stair", &params).is_err());
+            assert_eq!(s.model.to_json().unwrap(), before);
+        }
+        s.execute("modify", &json!({"id":id,"open":true})).unwrap();
+        close(heights(&s, id, [980.0, 0.0]).0, 680.0);
+        assert!(s.execute("modify", &json!({"id":id,"width":20})).is_err());
+        assert_eq!(stair(&mut s, id)["width"], 1000.0);
+        s.execute("undo", &json!({})).unwrap();
+        assert_eq!(s.model.to_json().unwrap(), before);
+        s.execute("redo", &json!({})).unwrap();
+        assert_eq!(stair(&mut s, id)["open"], true);
+    }
+}
diff --git a/crates/core/tests/opening_elevation.rs b/crates/core/tests/opening_elevation.rs
new file mode 100644
index 00000000..9003ca98
--- /dev/null
+++ b/crates/core/tests/opening_elevation.rs
@@ -0,0 +1,110 @@
+//! Requested-level opening placement, exercised through the shared CLI/MCP command entry point.
+#[cfg(test)]
+mod tests {
+    use bimcraft_core::engine::Session;
+    use bimcraft_core::model::{Element, Id};
+    use bimcraft_core::render::{self, View};
+    use serde_json::json;
+
+    const WALL: &str = r#"level {"name":"Upper","elevation":3400}
+wall {"points":[[0,0],[8000,0]],"level":"Level 1","height":7200}"#;
+
+    fn sill_z(s: &Session, id: Id) -> f64 {
+        let (Element::Door(o) | Element::Window(o)) = s.model.elements.get(id).unwrap() else { panic!("not an opening") };
+        s.model.opening_frame(o).unwrap().2
+    }
+
+    #[test]
+    fn upper_level_window_is_visible_on_its_plan_and_survives_save_reopen() {
+        let mut s = Session::new();
+        s.script(WALL).unwrap();
+        let id = s.execute("window", &json!({"at":[4000,0],"level":"Upper","sill":900})).unwrap()["id"].as_u64().unwrap();
+        assert_eq!(sill_z(&s, id), 4300.0, "requested level + sill, not host base + sill");
+        let upper = s.model.levels().into_iter().find(|(_, l)| l.name == "Upper").unwrap().0;
+        let view = View { scale: 0.1, cx: 4000.0, cy: 0.0, width: 1000, height: 400 };
+        let drawing = render::draw(&s.model, upper, view);
+        assert!(
+            drawing.pick_all(view.px(bimcraft_core::geom::P2(4000.0, 0.0)), 5.0).contains(&id),
+            "window visible and pickable on upper plan"
+        );
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("upper.bimcraft");
+        s.execute("save", &json!({"path":path})).unwrap();
+        let guid = s.model.guid(id);
+        let mut reopened = Session::new();
+        let opened = reopened.execute("open", &json!({"path":path})).unwrap();
+        assert!(opened.get("left_out").is_none(), "native file must be fully understood: {opened}");
+        let id = reopened.model.elements.id(guid).unwrap();
+        assert_eq!(sill_z(&reopened, id), 4300.0);
+        assert!(render::draw(&reopened.model, upper, view).owners.contains(&Some(id)));
+    }
+
+    #[test]
+    fn explicit_host_honors_requested_level_for_doors_and_default_window_sills() {
+        for command in ["door", "window"] {
+            let mut s = Session::new();
+            s.script(WALL).unwrap();
+            let wall = s.model.elements.iter().find(|(_, e)| matches!(e, Element::Wall(_))).unwrap().0;
+            let result = s.execute(command, &json!({"wall":wall,"offset":4000,"level":"Upper"})).unwrap();
+            let id = result["id"].as_u64().unwrap();
+            let expected = if command == "door" { 3400.0 } else { 4300.0 };
+            assert_eq!(sill_z(&s, id), expected, "{command}");
+        }
+    }
+
+    #[test]
+    fn host_relative_placement_without_a_different_requested_level_is_preserved() {
+        for level in [None, Some("Level 1")] {
+            let mut s = Session::new();
+            s.script(r#"wall {"points":[[0,0],[8000,0]],"base_offset":6000,"height":3000}"#).unwrap();
+            let wall = s.model.elements.iter().find(|(_, e)| matches!(e, Element::Wall(_))).unwrap().0;
+            let result = s.execute("window", &json!({"wall":wall,"level":level,"sill":900})).unwrap();
+            assert_eq!(sill_z(&s, result["id"].as_u64().unwrap()), 6900.0);
+        }
+    }
+
+    #[test]
+    fn different_requested_level_accounts_for_the_host_base_offset() {
+        let mut s = Session::new();
+        s.script(
+            r#"level {"name":"Upper","elevation":3400}
+wall {"points":[[0,0],[8000,0]],"base_offset":500,"height":7200}"#,
+        )
+        .unwrap();
+        let id = s.execute("window", &json!({"at":[4000,0],"level":"Upper","sill":900})).unwrap()["id"].as_u64().unwrap();
+        assert_eq!(sill_z(&s, id), 4300.0);
+        let Element::Window(o) = s.model.elements.get(id).unwrap() else { panic!("not a window") };
+        assert_eq!(o.sill, 3800.0, "native sill remains relative to host own base");
+    }
+
+    #[test]
+    fn upper_level_family_window_uses_its_default_sill_in_preview_and_placement() {
+        let mut s = Session::new();
+        s.script(WALL).unwrap();
+        let params = json!({"at":[4000,0],"level":"Upper","family":"Fixed Window","type":"600 x 900"});
+        let Element::Window(preview) = bimcraft_core::opening_of(&s.model, &params, false).unwrap() else { panic!("not a window") };
+        assert_eq!(s.model.opening_frame(&preview).unwrap().2, 4500.0);
+        let result = s.execute("window", &params).unwrap();
+        assert_eq!(sill_z(&s, result["id"].as_u64().unwrap()), 4500.0);
+    }
+
+    #[test]
+    fn requested_level_outside_host_is_rejected_atomically() {
+        let mut s = Session::new();
+        s.script(WALL).unwrap();
+        s.execute("level", &json!({"name":"Too high","elevation":9000})).unwrap();
+        let wall = *s.model.elements.iter().find(|(_, e)| matches!(e, Element::Wall(_))).unwrap().0;
+        let before = serde_json::to_value(&*s.model).unwrap();
+        let error = s.execute("window", &json!({"wall":wall,"level":"Too high"})).unwrap_err();
+        assert!(error.contains("top of wall"), "{error}");
+        assert_eq!(serde_json::to_value(&*s.model).unwrap(), before);
+        let error = s.execute("window", &json!({"wall":wall,"level":"Missing"})).unwrap_err();
+        assert!(error.contains("no level"), "{error}");
+        assert_eq!(serde_json::to_value(&*s.model).unwrap(), before);
+        s.execute("level", &json!({"name":"Below","elevation":-1000})).unwrap();
+        let before = serde_json::to_value(&*s.model).unwrap();
+        let error = s.execute("window", &json!({"wall":wall,"level":"Below"})).unwrap_err();
+        assert!(error.contains("under wall"), "{error}");
+        assert_eq!(serde_json::to_value(&*s.model).unwrap(), before);
+    }
+}
diff --git a/crates/core/tests/opening_level.rs b/crates/core/tests/opening_level.rs
new file mode 100644
index 00000000..d255b569
--- /dev/null
+++ b/crates/core/tests/opening_level.rs
@@ -0,0 +1,186 @@
+//! Opening host inference through the same commands used by the CLI and MCP.
+#[cfg(test)]
+mod tests {
+    use bimcraft_core::engine::Session;
+    use serde_json::{Value, json};
+
+    fn run(s: &mut Session, command: &str, params: Value) -> Value {
+        s.execute(command, &params).unwrap_or_else(|e| panic!("{command} {params}: {e}"))
+    }
+
+    fn fixture() -> Session {
+        let mut s = Session::new();
+        run(&mut s, "level", json!({"name": "Foundation", "elevation": -2400}));
+        s
+    }
+
+    fn wall(s: &mut Session, level: &str, y: f64) -> Value {
+        run(s, "wall", json!({"level": level, "points": [[0, y], [6000, y]], "height": 2400}))["ids"][0].clone()
+    }
+
+    #[test]
+    fn openings_without_a_level_find_the_ground_wall_and_survive_save_and_reopen() {
+        let mut s = fixture();
+        let host = wall(&mut s, "Level 1", 0.0);
+        let door = run(&mut s, "door", json!({"at": [1500, 0]}));
+        let window = run(&mut s, "window", json!({"at": [4200, 0]}));
+        assert_eq!(door["host"], host);
+        assert_eq!(window["host"], host);
+        let before = run(&mut s, "elements", json!({}));
+        let folder = tempfile::tempdir().unwrap();
+        let path = folder.path().join("openings.bimcraft");
+        run(&mut s, "save", json!({"path": path}));
+        let mut reopened = Session::new();
+        let opened = run(&mut reopened, "open", json!({"path": path}));
+        assert!(opened.get("left_out").is_none(), "{opened}");
+        assert_eq!(run(&mut reopened, "elements", json!({})), before);
+    }
+
+    #[test]
+    fn openings_without_a_level_find_an_upper_floor_when_it_is_the_only_host() {
+        for command in ["door", "window"] {
+            let mut s = fixture();
+            let host = wall(&mut s, "Level 2", 0.0);
+            assert_eq!(run(&mut s, command, json!({"at": [2000, 0]}))["host"], host);
+        }
+    }
+
+    #[test]
+    fn stacked_hosts_prefer_the_lowest_eligible_level_at_or_above_zero() {
+        for command in ["door", "window"] {
+            let mut s = fixture();
+            wall(&mut s, "Foundation", 0.0);
+            wall(&mut s, "Level 2", 0.0);
+            let ground = wall(&mut s, "Level 1", 0.0);
+            assert_eq!(run(&mut s, command, json!({"at": [2000, 0]}))["host"], ground);
+        }
+    }
+
+    #[test]
+    fn below_ground_hosts_prefer_the_highest_eligible_level() {
+        for command in ["door", "window"] {
+            let mut s = fixture();
+            run(&mut s, "level", json!({"name": "Basement", "elevation": -4800}));
+            wall(&mut s, "Basement", 0.0);
+            let foundation = wall(&mut s, "Foundation", 0.0);
+            assert_eq!(run(&mut s, command, json!({"at": [2000, 0]}))["host"], foundation);
+        }
+    }
+
+    #[test]
+    fn explicit_level_overrides_inference_and_never_falls_back() {
+        for command in ["door", "window"] {
+            let mut s = fixture();
+            let ground = wall(&mut s, "Level 1", 0.0);
+            let upper = wall(&mut s, "Level 2", 0.0);
+            assert_eq!(run(&mut s, command, json!({"at": [2000, 0], "level": "Level 2"}))["host"], upper);
+            let before = run(&mut s, "elements", json!({}));
+            let error = s.execute(command, &json!({"at": [2000, 0], "level": "Foundation"})).unwrap_err();
+            assert_eq!(
+                error,
+                format!(
+                    "{command}: no wall at [2000, 0] on Foundation; wall {ground} stands there but spans 0 to 2400 mm and Foundation cuts at -1200 mm: give the wall that level, or a view range that cuts it"
+                )
+            );
+            assert!(error.contains("no wall at [2000, 0] on Foundation"), "{error}");
+            assert!(error.contains("stands there but spans"), "preserve the cut-range diagnostic: {error}");
+            assert_eq!(run(&mut s, "elements", json!({})), before);
+        }
+    }
+
+    #[test]
+    fn no_eligible_host_reports_the_point_and_preserves_the_model_and_undo() {
+        for command in ["door", "window"] {
+            let mut s = fixture();
+            wall(&mut s, "Level 1", 0.0);
+            let before = run(&mut s, "elements", json!({}));
+            let error = s.execute(command, &json!({"at": [2000, 4000]})).unwrap_err();
+            assert!(error.contains("no wall at [2000, 4000] on any level"), "{error}");
+            assert!(error.contains("`wall` with `offset`"), "{error}");
+            assert_eq!(run(&mut s, "elements", json!({})), before);
+            run(&mut s, "undo", json!({}));
+            assert_eq!(run(&mut s, "elements", json!({"category": "walls"}))["count"], 0);
+        }
+    }
+
+    #[test]
+    fn an_inferred_host_still_rejects_an_opening_outside_the_wall_atomically() {
+        let mut s = fixture();
+        wall(&mut s, "Level 1", 0.0);
+        let before = run(&mut s, "elements", json!({}));
+        assert!(s.execute("door", &json!({"at": [20, 0]})).is_err());
+        assert_eq!(run(&mut s, "elements", json!({})), before);
+        assert_eq!(run(&mut s, "door", json!({"at": [2000, 0]}))["mark"], "1");
+    }
+
+    #[test]
+    fn explicit_wall_remains_authoritative_even_with_a_different_level() {
+        let mut s = fixture();
+        let upper = wall(&mut s, "Level 2", 0.0);
+        let before = run(&mut s, "elements", json!({}));
+        let error = s.execute("door", &json!({"wall": upper, "offset": 2000, "level": "Foundation"})).unwrap_err();
+        assert!(error.contains("under wall"), "the requested elevation must fit the explicit host: {error}");
+        assert_eq!(run(&mut s, "elements", json!({})), before);
+        let tall = run(&mut s, "wall", json!({"level":"Foundation","points":[[0,8000],[6000,8000]],"height":9000}))["ids"][0].clone();
+        let door = run(&mut s, "door", json!({"wall":tall,"offset":2000,"level":"Level 2"}));
+        assert_eq!(door["host"], tall, "explicit wall stays authoritative at a valid requested elevation");
+        let bimcraft_core::model::Element::Door(opening) = &s.model.elements[&door["id"].as_u64().unwrap()] else { panic!("not a door") };
+        assert_eq!(s.model.opening_frame(opening).unwrap().2, 3000.0);
+    }
+
+    #[test]
+    fn an_implicit_level_failure_keeps_wall_span_and_cut_context_without_an_undo_step() {
+        for command in ["door", "window"] {
+            let mut s = fixture();
+            let host = run(&mut s, "wall", json!({"level": "Level 2", "points": [[0, 0], [6000, 0]], "height": 600}))["ids"][0].clone();
+            let before = run(&mut s, "elements", json!({}));
+            let error = s.execute(command, &json!({"at": [2000, 0]})).unwrap_err();
+            assert!(error.contains("no wall at [2000, 0] on any level"), "{error}");
+            assert!(error.contains(&format!("wall {host} stands there but spans 3000 to 3600 mm")), "{error}");
+            assert!(error.contains("Level 2 cuts at 4200 mm"), "{error}");
+            assert!(error.contains("`wall` with `offset`"), "{error}");
+            assert_eq!(run(&mut s, "elements", json!({})), before);
+            run(&mut s, "undo", json!({}));
+            assert_eq!(run(&mut s, "elements", json!({"category": "walls"}))["count"], 0);
+        }
